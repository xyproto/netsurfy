# ----------------------------------------------------------------------------
# Framebuffer-target-specific options
# ----------------------------------------------------------------------------

# Optimisation levels
CFLAGS += -O2

# Framebuffer default surface provider.
# Valid values are: x, sdl, linux, vnc, able,
NETSURFY_FB_FRONTEND := sdl

# Use libharu to enable PDF export and GTK printing support.
# Valid options: YES, NO
NETSURFY_USE_HARU_PDF := NO

# Enable NetSurfy's use of libsvgtiny for displaying SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_NSSVG := AUTO

# Enable NetSurfy's use of librosprite for displaying RISC OS Sprites
# Valid options: YES, NO, AUTO
NETSURFY_USE_ROSPRITE := AUTO

# Library to use for font plotting
# Valid options: internal, freetype
NETSURFY_FB_FONTLIB := internal

# Default freetype font files
NETSURFY_FB_FONT_SANS_SERIF := DejaVuSans.ttf
NETSURFY_FB_FONT_SANS_SERIF_BOLD := DejaVuSans-Bold.ttf
NETSURFY_FB_FONT_SANS_SERIF_ITALIC := DejaVuSans-Oblique.ttf
NETSURFY_FB_FONT_SANS_SERIF_ITALIC_BOLD := DejaVuSans-BoldOblique.ttf
NETSURFY_FB_FONT_SERIF := DejaVuSerif.ttf
NETSURFY_FB_FONT_SERIF_BOLD := DejaVuSerif-Bold.ttf
NETSURFY_FB_FONT_MONOSPACE := DejaVuSansMono.ttf
NETSURFY_FB_FONT_MONOSPACE_BOLD := DejaVuSansMono-Bold.ttf
NETSURFY_FB_FONT_CURSIVE := Comic_Sans_MS.ttf
NETSURFY_FB_FONT_FANTASY := Impact.ttf

# Default binary install path
NETSURFY_FRAMEBUFFER_BIN := $(PREFIX)/bin

# Default resource install path
NETSURFY_FRAMEBUFFER_RESOURCES := $(PREFIX)/share/netsurfy

# Default framebuffer search path
NETSURFY_FB_RESPATH := $${HOME}/.netsurfy/:$${NETSURFYRES}:$(NETSURFY_FRAMEBUFFER_RESOURCES):./frontends/framebuffer/res

# freetype compiled in font serch path
NETSURFY_FB_FONTPATH := /usr/share/fonts/truetype/dejavu:/usr/share/fonts/truetype/msttcorefonts


# ----------------------------------------------------------------------------
# Atari-specific options
# ----------------------------------------------------------------------------

# Force using glibc internal iconv implementation instead of external libiconv
# Valid options: YES, NO
NETSURFY_USE_LIBICONV_PLUG := NO

# Enable NetSurfy's use of librosprite for displaying RISC OS Sprites
# Valid options: YES, NO, AUTO
NETSURFY_USE_ROSPRITE := NO

# Enable NetSurfy's use of librsvg in conjunction with Cairo to display SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_RSVG := AUTO

# Enable NetSurfy's use of libsvgtiny for displaying SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_NSSVG := AUTO

# Enable building the source object cache filesystem based backing store.
# implementation.
# Valid options: YES, NO
NETSURFY_FS_BACKING_STORE := YES

# enable true type fonts via freetype2
# Valid options: YES, NO
NETSURFY_USE_ATARI_FREETYPE_FONT := YES

# Enable use of netsurfy embedded font
# Valid options: YES, NO
NETSURFY_USE_ATARI_NETSURFY_FONT := YES

# Enable VDI Font rendering
# Valid options: YES, NO
NETSURFY_USE_ATARI_VDI_FONT := NO

# Configure support for screen drivers with no true colour mode
# Valid options: YES, NO
NETSURFY_USE_ATARI_8BPP_SUPPORT := NO

# enable optimizations
# -O2 is currently broken with m68000 / m68020-60 builds
CFLAGS += -O3

# override warning flags removing -Wall
WARNFLAGS = -W -Wundef -Wpointer-arith \
		-Wcast-align -Wwrite-strings -Wstrict-prototypes \
		-Wmissing-prototypes -Wmissing-declarations -Wredundant-decls \
		-Wnested-externs -Wuninitialized -Wl,-t

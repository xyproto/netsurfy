# ----------------------------------------------------------------------------
# QT-specific options
# ----------------------------------------------------------------------------

# Where to search for NetSurfy's resources after looking in ~/.netsurfy and
# $NETSURFYRES.  It must have a trailing /
NETSURFY_QT_RES_PATH := $(PREFIX)/share/netsurfy/:./frontends/qt/res/

# Where to install the netsurfy binary
NETSURFY_QT_BIN := $(PREFIX)/bin/

# Enable NetSurfy's use of librsvg in conjunction with Cairo to display SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_RSVG := NO

# Enable NetSurfy's use of libsvgtiny for displaying SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_NSSVG := AUTO

# Enable NetSurfy's use of librosprite for displaying RISC OS Sprites
# Valid options: YES, NO, AUTO
NETSURFY_USE_ROSPRITE := NO

# Enable building the source object cache filesystem based backing store.
NETSURFY_FS_BACKING_STORE := NO

# Optimisation levels
CFLAGS += -O2

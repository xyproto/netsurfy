# -*- mode: makefile-gmake -*-
##
## determine the HOST TARGET and SUBTARGET
##

# Determine host type
HOST := $(shell uname -s)

# Sanitise host
# TODO: Ideally, we want the equivalent of s/[^A-Za-z0-9]/_/g here
HOST := $(subst .,_,$(subst -,_,$(subst /,_,$(HOST))))

ifeq ($(HOST),BeOS)
  HOST := beos
endif

ifeq ($(HOST),Haiku)
  # Haiku implements the BeOS API
  HOST := beos
endif

ifeq ($(HOST),FreeMiNT)
  HOST := mint
endif

ifeq ($(findstring MINGW,$(HOST)),MINGW)
  # MSYS' uname reports the likes of "MINGW32_NT-6.0"
  HOST := windows
endif

ifeq ($(HOST),OpenBSD)
  HOST := openbsd
endif

# Setup (sub)targets

ifeq ($(TARGET),)
  ifeq ($(HOST),beos)
    # Build happening on BeOS platform, default target is beos backend
    TARGET := beos
    SUBTARGET=
  else ifeq ($(HOST),mint)
    # Build happening on FreeMiNT platform, default target is atari backend
    TARGET := atari
    SUBTARGET=
  else ifeq ($(HOST),windows)
    # Build happening on Windows platform, default target is windows backend
    TARGET := windows
    SUBTARGET=
  else
    # Default target is GTK 4 backend
    override TARGET := gtk
    SUBTARGET = 4
  endif
else
  ifeq ($(TARGET),gtk)
    # unspecified gtk is gtk4
    SUBTARGET = 4
  else
    ifeq ($(TARGET),gtk4)
      # gtk4 is gtk target with subtarget of 4
      override TARGET := gtk
      SUBTARGET = 4
    else
      ifeq ($(TARGET),haiku)
        override TARGET := beos
        SUBTARGET=
      endif
    endif
  endif
endif

# valid values for the TARGET
VLDTARGET := atari beos framebuffer gtk monkey qt windows

# Check for valid TARGET
ifeq ($(filter $(VLDTARGET),$(TARGET)),)
  $(error Unknown TARGET "$(TARGET)", Must be one of $(VLDTARGET))
endif

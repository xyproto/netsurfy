# ----------------------------------------------------------------------------
# Monkey-specific options
# ----------------------------------------------------------------------------

# How did I get mixed up with this fucking monkey anyhow?
NETSURFY_MONKEY_RESOURCES := $(PREFIX)/share/netsurfy/
NETSURFY_MONKEY_BIN := $(PREFIX)/bin/
NETSURFY_USE_RSVG := NO
NETSURFY_USE_NSSVG := NO
NETSURFY_USE_ROSPRITE := NO
NETSURFY_USE_HARU_PDF := NO
NETSURFY_FS_BACKING_STORE := YES

CFLAGS += -O2

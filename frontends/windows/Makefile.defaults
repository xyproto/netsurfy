# ----------------------------------------------------------------------------
# windows-specific options
# ----------------------------------------------------------------------------

# Where to search for NetSurfy's resources after looking in ~/.netsurfy and
# ${APPDATA}\NetSurfy.  It must have a trailing backslash
NETSURFY_WINDOWS_RESPATH := $${NETSURFYRES}

# Enable NetSurfy's use of librosprite for displaying RISC OS Sprites
# Valid options: YES, NO, AUTO
NETSURFY_USE_ROSPRITE := NO

# Enable NetSurfy's use of libsvgtiny for displaying SVGs
# Valid options: YES, NO
NETSURFY_USE_NSSVG := NO

# Force using glibc internal iconv implementation instead of external libiconv
# Valid options: YES, NO
NETSURFY_USE_LIBICONV_PLUG := NO

# no pdf support
NETSURFY_USE_HARU_PDF := NO

# Optimisation levels
CFLAGS += -O2

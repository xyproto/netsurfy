<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="menubar_model">
    <submenu>
      <attribute name="label" translatable="yes">gtkFile</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">SaveAs</attribute>
          <attribute name="action">win.viewdata_save_as</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">gtkPrint</attribute>
          <attribute name="action">win.viewdata_print</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name="label" translatable="yes">gtkCloseWindow</attribute>
          <attribute name="action">win.viewdata_close</attribute>
        </item>
      </section>
    </submenu>
    <submenu>
      <attribute name="label" translatable="yes">gtkEdit</attribute>
      <item>
        <attribute name="label" translatable="yes">gtkSelectAll</attribute>
        <attribute name="action">win.viewdata_select_all</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkCut</attribute>
        <attribute name="action">win.viewdata_cut</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkCopy</attribute>
        <attribute name="action">win.viewdata_copy</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkPaste</attribute>
        <attribute name="action">win.viewdata_paste</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkDelete</attribute>
        <attribute name="action">win.viewdata_delete</attribute>
      </item>
    </submenu>
    <submenu>
      <attribute name="label" translatable="yes">gtkView</attribute>
      <item>
        <attribute name="label" translatable="yes">gtkZoomPlus</attribute>
        <attribute name="action">win.viewdata_zoom_in</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkZoomMinus</attribute>
        <attribute name="action">win.viewdata_zoom_out</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">gtkZoomNormal</attribute>
        <attribute name="action">win.viewdata_zoom_normal</attribute>
      </item>
    </submenu>
    <submenu>
      <attribute name="label" translatable="yes">gtkHelp</attribute>
      <item>
        <attribute name="label" translatable="yes">gtkAbout</attribute>
        <attribute name="action">win.viewdata_about</attribute>
      </item>
    </submenu>
  </menu>
  <object class="GtkWindow" id="ViewDataWindow">
    <property name="default_width">640</property>
    <property name="default_height">480</property>
    <property name="child">
      <object class="GtkBox" id="box1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPopoverMenuBar" id="menubar1">
            <property name="menu_model">menubar_model</property>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="sourcescrolled">
            <property name="vexpand">True</property>
            <property name="child">
              <object class="GtkTextView" id="viewdata_view">
                <property name="editable">False</property>
                <property name="wrap_mode">word</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>

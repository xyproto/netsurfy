<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="wndPDFPassword">
    <property name="title" translatable="1">PDF Password</property>
    <property name="modal">1</property>
    <property name="child">
      <object class="GtkBox" id="hbox1">
        <property name="spacing">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkImage" id="image1">
            <property name="valign">start</property>
            <property name="icon-size">large</property>
            <property name="icon-name">dialog-password</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="orientation">vertical</property>
            <property name="hexpand">1</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkLabel" id="labelInfo">
                <property name="xalign">0</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="gridPasswords">
                <property name="row-spacing">6</property>
                <property name="column-spacing">10</property>
        <child>
          <object class="GtkLabel" id="label4">
            <property name="label" translatable="1">Owner password</property>
            <property name="xalign">1</property>
            <property name="width-chars">15</property>
            <layout>
              <property name="column">0</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="entryPDFOwnerPassword">
            <property name="width-chars">20</property>
            <layout>
              <property name="column">1</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label5">
            <property name="label" translatable="1">Repeat password</property>
            <property name="xalign">1</property>
            <property name="width-chars">15</property>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="entryPDFOwnerPassword1">
            <property name="width-chars">20</property>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label6">
            <property name="label" translatable="1">User password</property>
            <property name="xalign">1</property>
            <property name="width-chars">15</property>
            <layout>
              <property name="column">0</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="entryPDFUserPassword">
            <property name="width-chars">20</property>
            <layout>
              <property name="column">1</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label7">
            <property name="label" translatable="1">Repeat password</property>
            <property name="xalign">1</property>
            <property name="width-chars">15</property>
            <layout>
              <property name="column">0</property>
              <property name="row">3</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="entryPDFUserPassword1">
            <property name="width-chars">20</property>
            <layout>
              <property name="column">1</property>
              <property name="row">3</property>
            </layout>
          </object>
        </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbuttonbox1">
                <property name="halign">end</property>
                <property name="spacing">10</property>
            <child>
              <object class="GtkButton" id="buttonPDFSetPassword">
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">dialog-password</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">Use these as passwords</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="buttonPDFNoPassword">
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">process-stop</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">Do not set any passwords</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>

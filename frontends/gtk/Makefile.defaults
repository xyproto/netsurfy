# ----------------------------------------------------------------------------
# GTK-specific options
# ----------------------------------------------------------------------------

# Where to search for NetSurfy's resources after looking in ~/.netsurfy and
# $NETSURFYRES.  It must have a trailing /
NETSURFY_GTK_RES_PATH := $(PREFIX)/share/netsurfy/:./frontends/gtk/res/

# Where to install the netsurfy binary
NETSURFY_GTK_BIN := $(PREFIX)/bin/

# Enable NetSurfy's use of librsvg in conjunction with Cairo to display SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_RSVG := AUTO

# Enable NetSurfy's use of libsvgtiny for displaying SVGs
# Valid options: YES, NO, AUTO
NETSURFY_USE_NSSVG := AUTO

# Enable NetSurfy's use of librosprite for displaying RISC OS Sprites
# Valid options: YES, NO, AUTO
NETSURFY_USE_ROSPRITE := AUTO

# Enable the use of GLib compiled in resource handling. This requires
#  GLib 2.32 or later
# Valid options: YES, NO, AUTO
NETSURFY_USE_GRESOURCE := AUTO

# Enable the use of compiled in inline pixbuf. This is depricated
#  since GLib 2.32. The automatic selection is disabled if GRESOURCE
#  handling is enabled
# Valid options: YES, NO, AUTO
NETSURFY_USE_INLINE_PIXBUF := AUTO

# Enable building the source object cache filesystem based backing store.
NETSURFY_FS_BACKING_STORE := YES

# GTK version to build for
NETSURFY_GTK_MAJOR ?= 4

# Optimisation levels
CFLAGS += -O2

method Text::splitText()
%{
	uint32_t offset = 0;
	dom_text *result = NULL;
	dom_exception exc;
	JSValue ret;

	if (JS_ToUint32(ctx, &offset, argv[0]) < 0) return JS_EXCEPTION;
	exc = dom_text_split_text(priv->parent.parent.node, offset, &result);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, (dom_node *)result);
	dom_node_unref(result);
	return ret;
%}

getter Text::wholeText()
%{
	dom_string *text = NULL;
	JSValue ret;

	if (dom_text_get_whole_text(priv->parent.parent.node, &text) != DOM_NO_ERR) return JS_ThrowOutOfMemory(ctx);
	if (text == NULL) return JS_NewString(ctx, "");
	ret = qjsky_string(ctx, text);
	dom_string_unref(text);
	return ret;
%}

class DOMTokenList {
	private struct dom_tokenlist *tokens;
	prologue %{
static dom_string *token_arg(JSContext *ctx, JSValueConst val)
{
	dom_string *value = NULL;
	size_t slen;
	const char *s = JS_ToCStringLen(ctx, &slen, val);

	if (s == NULL) {
		return NULL;
	}
	if (dom_string_create_interned((const uint8_t *)s, slen, &value) != DOM_NO_ERR) {
		value = NULL;
	}
	JS_FreeCString(ctx, s);
	return value;
}
%};
};

init DOMTokenList(struct dom_tokenlist *tokens)
%{
	priv->tokens = tokens;
	dom_tokenlist_ref(tokens);
%}

fini DOMTokenList()
%{
	dom_tokenlist_unref(priv->tokens);
%}

getter DOMTokenList::length()
%{
	uint32_t len;

	if (dom_tokenlist_get_length(priv->tokens, &len) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewUint32(ctx, len);
%}

method DOMTokenList::item()
%{
	uint32_t i;
	dom_string *value;
	JSValue ret;

	if (JS_ToUint32(ctx, &i, argv[0]) < 0) return JS_EXCEPTION;
	if (dom_tokenlist_item(priv->tokens, i, &value) != DOM_NO_ERR) return JS_UNDEFINED;
	if (value == NULL) return JS_NULL;
	ret = qjsky_string(ctx, value);
	dom_string_unref(value);
	return ret;
%}

method DOMTokenList::add()
%{
	for (int spos = 0; spos < argc; ++spos) {
		dom_string *value = token_arg(ctx, argv[spos]);
		if (value == NULL) return JS_EXCEPTION;
		(void)dom_tokenlist_add(priv->tokens, value);
		dom_string_unref(value);
	}
	return JS_UNDEFINED;
%}

method DOMTokenList::remove()
%{
	for (int spos = 0; spos < argc; ++spos) {
		dom_string *value = token_arg(ctx, argv[spos]);
		if (value == NULL) return JS_EXCEPTION;
		(void)dom_tokenlist_remove(priv->tokens, value);
		dom_string_unref(value);
	}
	return JS_UNDEFINED;
%}

method DOMTokenList::contains()
%{
	dom_exception exc;
	dom_string *value = token_arg(ctx, argv[0]);
	bool present = false;

	if (value == NULL) return JS_EXCEPTION;
	exc = dom_tokenlist_contains(priv->tokens, value, &present);
	dom_string_unref(value);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, present);
%}

method DOMTokenList::toggle()
%{
	dom_string *value;
	bool present;
	bool want;

	if (argc < 1) return JS_ThrowTypeError(ctx, "1 argument required, but only 0 present.");
	value = token_arg(ctx, argv[0]);
	if (value == NULL) return JS_EXCEPTION;
	if (dom_tokenlist_contains(priv->tokens, value, &present) != DOM_NO_ERR) {
		dom_string_unref(value);
		return JS_UNDEFINED;
	}
	if (argc > 1 && !JS_IsUndefined(argv[1])) {
		want = JS_ToBool(ctx, argv[1]) > 0;
	} else {
		want = !present;
	}
	if (want) {
		(void)dom_tokenlist_add(priv->tokens, value);
	} else {
		(void)dom_tokenlist_remove(priv->tokens, value);
	}
	dom_string_unref(value);
	return JS_NewBool(ctx, want);
%}

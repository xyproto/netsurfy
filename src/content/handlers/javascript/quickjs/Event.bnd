class Event {
      private dom_event *evt;
};

init Event (struct dom_event *evt)
%{
	priv->evt = evt;
	dom_event_ref(evt);
%}

constructor Event ()
%{
	dom_event *evt;
	dom_string *type;
	bool bubbles = false, cancelable = false;
	JSValue dict = argc > 1 ? argv[1] : JS_UNDEFINED;
	JSValue obj;

	if (argc < 1) return JS_ThrowTypeError(ctx, "Failed to construct 'Event': 1 argument required");
	if (qjsky_dict_bool(ctx, dict, "bubbles", &bubbles) < 0 ||
	    qjsky_dict_bool(ctx, dict, "cancelable", &cancelable) < 0) return JS_EXCEPTION;
	type = qjsky_to_dom_string(ctx, argv[0]);
	if (type == NULL) return JS_EXCEPTION;
	obj = qjsky_create_event(ctx, "Event", &evt);
	if (evt == NULL) {
		dom_string_unref(type);
		return obj;
	}
	(void)dom_event_init(evt, type, bubbles, cancelable);
	dom_string_unref(type);
	obj = qjsky_event(ctx, evt);
	dom_event_unref(evt);
	return qjsky_constructed(ctx, obj, new_target);
%}

fini Event ()
%{
	dom_event_unref(priv->evt);
%}

getter Event::type ()
%{
	dom_string *ret = NULL;
	JSValue val;

	if (dom_event_get_type(priv->evt, &ret) != DOM_NO_ERR) return JS_UNDEFINED;
	if (ret == NULL) return JS_NewString(ctx, "");
	val = qjsky_string(ctx, ret);
	dom_string_unref(ret);
	return val;
%}

getter Event::target ()
%{
	dom_node *et = NULL;
	JSValue ret;

	if (dom_event_get_target(priv->evt, &et) != DOM_NO_ERR) return JS_UNDEFINED;
	ret = qjsky_node(ctx, et);
	if (et != NULL) dom_node_unref(et);
	return ret;
%}

getter Event::currentTarget ()
%{
	dom_node *et = NULL;
	JSValue ret;

	if (dom_event_get_current_target(priv->evt, &et) != DOM_NO_ERR) return JS_UNDEFINED;
	ret = qjsky_node(ctx, et);
	if (et != NULL) dom_node_unref(et);
	return ret;
%}

getter Event::eventPhase ()
%{
	dom_event_flow_phase phase;

	if (dom_event_get_event_phase(priv->evt, &phase) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewUint32(ctx, phase);
%}

method Event::stopPropagation ()
%{
	(void)dom_event_stop_propagation(priv->evt);
	return JS_UNDEFINED;
%}

method Event::stopImmediatePropagation ()
%{
	(void)dom_event_stop_immediate_propagation(priv->evt);
	return JS_UNDEFINED;
%}

getter Event::bubbles ()
%{
	bool ret;

	if (dom_event_get_bubbles(priv->evt, &ret) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, ret);
%}

getter Event::cancelable ()
%{
	bool ret;

	if (dom_event_get_cancelable(priv->evt, &ret) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, ret);
%}

method Event::preventDefault ()
%{
	(void)dom_event_prevent_default(priv->evt);
	return JS_UNDEFINED;
%}

getter Event::defaultPrevented ()
%{
	bool ret;

	if (dom_event_is_default_prevented(priv->evt, &ret) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, ret);
%}

getter Event::isTrusted ()
%{
	bool ret;

	if (dom_event_get_is_trusted(priv->evt, &ret) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, ret);
%}

method Event::initEvent ()
%{
	dom_string *text_str = qjsky_to_dom_string(ctx, argv[0]);
	int bubbles = JS_ToBool(ctx, argv[1]);
	int cancellable = JS_ToBool(ctx, argv[2]);

	if (text_str == NULL) return JS_EXCEPTION;
	(void)dom_event_init(priv->evt, text_str, bubbles > 0, cancellable > 0);
	dom_string_unref(text_str);
	return JS_UNDEFINED;
%}

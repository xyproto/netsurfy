%}

getter URL::pathname()
%{
	return qjsky_url_get(ctx, priv->url, QJSKY_URL_PATHNAME);
%}

setter URL::pathname()
%{
	return url_set_part(ctx, priv, QJSKY_URL_PATHNAME, argv[0]);
%}

getter URL::search()
%{
	return qjsky_url_get(ctx, priv->url, QJSKY_URL_SEARCH);
%}

setter URL::search()
%{
	return url_set_part(ctx, priv, QJSKY_URL_SEARCH, argv[0]);
%}

getter URL::hash()
%{
	return qjsky_url_get(ctx, priv->url, QJSKY_URL_HASH);
%}

setter URL::hash()

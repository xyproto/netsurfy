class Window {
	private struct browser_window * win;
	private struct html_content * htmlc;
	private struct window_schedule_s * schedule_ring;
	private bool closed_down;
	prologue %{
#include <nsutils/time.h>

#include "utils/corestrings.h"
#include "utils/nsurl.h"
#include "netsurfy/browser_window.h"
#include "content/hlcache.h"
#include "html/html.h"
#include "html/private.h"
#include "desktop/gui_internal.h"
#include "netsurfy/misc.h"
#include "utils/ring.h"
#include "desktop/browser_private.h"
#include "netsurfy/window.h"
#include "netsurfy/inttypes.h"

static size_t next_handle = 1;

typedef struct window_schedule_s {
	window_private_t *owner;
	JSContext *ctx;
	struct window_schedule_s *r_next;
	struct window_schedule_s *r_prev;
	size_t handle;
	int repeat_timeout;
	bool running;
} window_schedule_t;

static void window_remove_callback_bits(JSContext *ctx, size_t handle)
{
	JSValue global = JS_GetGlobalObject(ctx);
	JSValue cbt = qjsky_hidden_get(ctx, global, QJSKY_HIDDEN_WINDOW_CALLBACKS, false);
	if (JS_IsObject(cbt)) {
		JSAtom key = JS_NewAtomUInt32(ctx, (uint32_t)handle);
		JS_DeleteProperty(ctx, cbt, key, 0);
		JS_FreeAtom(ctx, key);
	}
	JS_FreeValue(ctx, cbt);
	JS_FreeValue(ctx, global);
}

static void
window_call_callback(JSContext *ctx, size_t handle, bool clear_entry)
{
	JSValue global = JS_GetGlobalObject(ctx);
	JSValue cbt = qjsky_hidden_get(ctx, global, QJSKY_HIDDEN_WINDOW_CALLBACKS, false);
	JSValue cbo = JS_GetPropertyUint32(ctx, cbt, (uint32_t)handle);
	JSValue func = JS_GetPropertyStr(ctx, cbo, "func");
	JSValue args = JS_GetPropertyStr(ctx, cbo, "args");
	int64_t nargs = 0;
	JSValue *argv = NULL;
	JSValue ret;

	if (JS_IsObject(cbo)) {
		if (JS_GetLength(ctx, args, &nargs) < 0) {
			nargs = 0;
		}
		if (nargs > 0) {
			argv = calloc(nargs, sizeof(JSValue));
			if (argv == NULL) {
				nargs = 0;
			}
		}
		for (int64_t i = 0; i < nargs; i++) {
			argv[i] = JS_GetPropertyInt64(ctx, args, i);
		}
		if (JS_IsString(func)) {
			size_t len;
			const char *code = JS_ToCStringLen(ctx, &len, func);
			if (code != NULL) {
				qjsky_reset_timeout(ctx);
				ret = JS_Eval(ctx, code, len, "timeout", JS_EVAL_TYPE_GLOBAL);
				JS_FreeCString(ctx, code);
				if (JS_IsException(ret)) {
					qjsky_dump_error(ctx);
				}
				JS_FreeValue(ctx, ret);
			}
		} else {
			ret = qjsky_call(ctx, func, global, (int)nargs, argv, true);
			JS_FreeValue(ctx, ret);
		}
		for (int64_t i = 0; i < nargs; i++) {
			JS_FreeValue(ctx, argv[i]);
		}
		free(argv);
	}
	JS_FreeValue(ctx, args);
	JS_FreeValue(ctx, func);
	JS_FreeValue(ctx, cbo);
	JS_FreeValue(ctx, cbt);
	JS_FreeValue(ctx, global);
	if (clear_entry) {
		window_remove_callback_bits(ctx, handle);
	}
}

static void
window_schedule_callback(void *p)
{
	window_schedule_t *priv = (window_schedule_t *)p;

	NSLOG(qjsky, DEEPDEBUG,
	      "Entered window scheduler callback: %"PRIsizet, priv->handle);

	priv->running = true;
	window_call_callback(priv->ctx,
			     priv->handle,
			     priv->repeat_timeout == 0);
	priv->running = false;

	if (priv->repeat_timeout > 0) {
		guit->misc->schedule(priv->repeat_timeout,
				     window_schedule_callback,
				     priv);
	} else {
		RING_REMOVE(priv->owner->schedule_ring, priv);
		window_remove_callback_bits(priv->ctx, priv->handle);
		free(priv);
	}
}

static size_t
window_alloc_new_callback(JSContext *ctx,
			  window_private_t *window,
			  bool repeating,
			  int timeout,
			  JSValueConst func,
			  int nargs,
			  JSValueConst *args)
{
	size_t new_handle = next_handle++;
	window_schedule_t *sched;
	JSValue global, cbt, cbo, arr;

	sched = calloc(1, sizeof *sched);
	if (sched == NULL) {
		return new_handle;
	}
	sched->owner = window;
	sched->ctx = ctx;
	sched->handle = new_handle;
	sched->repeat_timeout = repeating ? timeout : 0;
	sched->running = false;

	RING_INSERT(window->schedule_ring, sched);

	global = JS_GetGlobalObject(ctx);
	cbt = qjsky_hidden_get(ctx, global, QJSKY_HIDDEN_WINDOW_CALLBACKS, true);
	cbo = JS_NewObject(ctx);
	JS_SetPropertyStr(ctx, cbo, "func", JS_DupValue(ctx, func));
	arr = JS_NewArray(ctx);
	for (int i = 0; i < nargs; i++) {
		JS_SetPropertyUint32(ctx, arr, i, JS_DupValue(ctx, args[i]));
	}
	JS_SetPropertyStr(ctx, cbo, "args", arr);
	JS_SetPropertyUint32(ctx, cbt, (uint32_t)new_handle, cbo);
	JS_FreeValue(ctx, cbt);
	JS_FreeValue(ctx, global);

	guit->misc->schedule(timeout, window_schedule_callback, sched);
	NSLOG(qjsky, DEEPDEBUG, "Scheduled callback %"PRIsizet" for %d ms from now", new_handle, timeout);

	return new_handle;
}

static void
window_remove_callback_by_handle(JSContext *ctx,
				 window_private_t *window,
				 size_t handle)
{
	int res;

	RING_ITERATE_START(window_schedule_t, window->schedule_ring, sched) {
		if (sched->handle == handle) {
			if (sched->running) {
				NSLOG(qjsky, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			} else {
				NSLOG(qjsky, DEEPDEBUG,
				      "Cancelled callback %"PRIsizet,
				      sched->handle);
				res = guit->misc->schedule(-1,
							   window_schedule_callback,
							   sched);
				assert(res == NSERROR_OK);
				RING_REMOVE(window->schedule_ring, sched);
				if (ctx != NULL) {
					window_remove_callback_bits(ctx, sched->handle);
				}
				free(sched);
			}
			RING_ITERATE_STOP(window->schedule_ring, sched);
		}
	} RING_ITERATE_END(window->schedule_ring, sched);
}

static JSValue
window_set_timer(JSContext *ctx, window_private_t *priv, bool repeating, int argc, JSValueConst *argv)
{
	int32_t timeout = 0;
	size_t handle;

	if (priv->closed_down == true || argc < 1) {
		return JS_UNDEFINED;
	}
	if (argc >= 2 && JS_ToInt32(ctx, &timeout, argv[1]) < 0) {
		return JS_EXCEPTION;
	}
	if (timeout < 10) {
		timeout = 10;
	}
	handle = window_alloc_new_callback(ctx, priv, repeating, (int)timeout,
					   argv[0], argc > 2 ? argc - 2 : 0, argv + 2);
	return JS_NewInt64(ctx, (int64_t)handle);
}

static float window_scale(window_private_t *priv)
{
	float scale = browser_window_get_scale(priv->win);
	return scale > 0 ? scale : 1.0f;
}

static void window_viewport(window_private_t *priv, int *width, int *height)
{
	*width = 0;
	*height = 0;
	if (priv->closed_down ||
	    browser_window_get_dimensions(priv->win, width, height) != NSERROR_OK) {
		*width = 0;
		*height = 0;
	}
}

static void window_scroll(window_private_t *priv, int *sx, int *sy)
{
	*sx = 0;
	*sy = 0;
	if (!priv->closed_down && priv->win->window != NULL &&
	    guit->window->get_scroll != NULL) {
		if (!guit->window->get_scroll(priv->win->window, sx, sy)) {
			*sx = 0;
			*sy = 0;
		}
	}
}

static JSValue window_scroll_to(JSContext *ctx, window_private_t *priv, int argc, JSValueConst *argv, bool relative)
{
	int sx, sy;
	double x, y, scale = window_scale(priv);
	struct rect rect;

	window_scroll(priv, &sx, &sy);
	x = relative ? 0 : sx / scale;
	y = relative ? 0 : sy / scale;
	if (argc > 0 && JS_IsObject(argv[0])) {
		JSValue v = JS_GetPropertyStr(ctx, argv[0], "left");
		if (!JS_IsUndefined(v) && JS_ToFloat64(ctx, &x, v) < 0) {
			JS_FreeValue(ctx, v);
			return JS_EXCEPTION;
		}
		JS_FreeValue(ctx, v);
		v = JS_GetPropertyStr(ctx, argv[0], "top");
		if (!JS_IsUndefined(v) && JS_ToFloat64(ctx, &y, v) < 0) {
			JS_FreeValue(ctx, v);
			return JS_EXCEPTION;
		}
		JS_FreeValue(ctx, v);
	} else {
		if (argc > 0 && JS_ToFloat64(ctx, &x, argv[0]) < 0) {
			return JS_EXCEPTION;
		}
		if (argc > 1 && JS_ToFloat64(ctx, &y, argv[1]) < 0) {
			return JS_EXCEPTION;
		}
	}
	if (x != x) {
		x = 0;
	}
	if (y != y) {
		y = 0;
	}
	if (relative) {
		x += sx / scale;
		y += sy / scale;
	}
	if (x < 0) {
		x = 0;
	}
	if (y < 0) {
		y = 0;
	}
	if (priv->closed_down || priv->win->window == NULL ||
	    guit->window->set_scroll == NULL) {
		return JS_UNDEFINED;
	}
	rect.x0 = rect.x1 = (int)(x * scale);
	rect.y0 = rect.y1 = (int)(y * scale);
	guit->window->set_scroll(priv->win->window, &rect);
	return JS_UNDEFINED;
}

static JSValue
window_cached_object(JSContext *ctx, JSValueConst this_val, qjsky_hidden key, JSValue (*create)(JSContext *ctx, void *ptr), void *ptr)
{
	JSValue global = JS_GetGlobalObject(ctx);
	JSValue obj = qjsky_hidden_get(ctx, global, key, false);

	if (JS_IsUndefined(obj)) {
		obj = create(ctx, ptr);
		if (!JS_IsException(obj)) {
			qjsky_hidden_set(ctx, global, key, JS_DupValue(ctx, obj));
		}
	}
	JS_FreeValue(ctx, global);
	return obj;
}

void qjsky_window_closedown(JSContext *ctx, void *window_priv)
{
	window_private_t *priv = window_priv;

	if (priv == NULL) {
		return;
	}

	priv->closed_down = true;

	NSLOG(qjsky, DEEPDEBUG, "Closing down thread");
	while (priv->schedule_ring != NULL) {
		window_schedule_t *to_remove = NULL;
		RING_ITERATE_START(window_schedule_t, priv->schedule_ring, sched) {
			if (sched->running == false) {
				to_remove = sched;
				RING_ITERATE_STOP(window->schedule_ring, sched);
			} else if (sched->repeat_timeout != 0) {
				NSLOG(qjsky, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			}
		} RING_ITERATE_END(priv->schedule_ring, sched);

		if (to_remove == NULL) {
			NSLOG(qjsky, DEEPDEBUG,
			      "Leaving in-train callbacks to unwind");
			break;
		}
		window_remove_callback_by_handle(ctx,
						 priv,
						 to_remove->handle);
	}
}

%};
};

init Window(struct browser_window *win, struct html_content *htmlc)
%{
	assert(win != NULL);
	assert(htmlc != NULL);
	priv->win = win;
	priv->htmlc = htmlc;
	priv->schedule_ring = NULL;
	priv->closed_down = false;
	NSLOG(netsurfy, DEEPDEBUG, "win=%p htmlc=%p", priv->win, priv->htmlc);

	NSLOG(netsurfy, DEEPDEBUG,
	      "URL is %s", nsurl_access(browser_window_access_url(priv->win)));
%}

fini Window()
%{
	NSLOG(qjsky, DEEPDEBUG, "Shutting down Window %p", priv->win);
	while (priv->schedule_ring != NULL) {
		window_remove_callback_by_handle(NULL, priv, priv->schedule_ring->handle);
	}
%}

getter Window::document()
%{
	return qjsky_node(ctx, (struct dom_node *)priv->htmlc->document);
%}

getter Window::window()
%{
	return JS_GetGlobalObject(ctx);
%}

getter Window::self()
%{
	return JS_GetGlobalObject(ctx);
%}

getter Window::frames()
%{
	return JS_GetGlobalObject(ctx);
%}

getter Window::top()
%{
	return JS_GetGlobalObject(ctx);
%}

getter Window::parent()
%{
	return JS_GetGlobalObject(ctx);
%}

getter Window::length()
%{
	return JS_NewInt32(ctx, 0);
%}

getter Window::closed()
%{
	return JS_NewBool(ctx, priv->closed_down);
%}

getter Window::console()
%{
	return window_cached_object(ctx, this_val, QJSKY_HIDDEN_CONSOLE, qjsky_console___create_ptr, NULL);
%}

getter Window::location()
%{
	return window_cached_object(ctx, this_val, QJSKY_HIDDEN_LOCATION, qjsky_location___create_ptr,
				    llcache_handle_get_url(priv->htmlc->base.llcache));
%}

getter Window::navigator()
%{
	return window_cached_object(ctx, this_val, QJSKY_HIDDEN_NAVIGATOR, qjsky_navigator___create_ptr, NULL);
%}

getter Window::name()
%{
	const char *name = NULL;
	browser_window_get_name(priv->win, &name);
	return JS_NewString(ctx, name != NULL ? name : "");
%}

setter Window::name()
%{
	const char *name = JS_ToCString(ctx, argv[0]);
	if (name == NULL) return JS_EXCEPTION;
	browser_window_set_name(priv->win, name);
	JS_FreeCString(ctx, name);
	return JS_UNDEFINED;
%}

method Window::alert()
%{
	if (argc == 0) {
		NSLOG(netsurfy, INFO, "JS ALERT");
	} else {
		size_t msg_len;
		const char *msg = JS_ToCStringLen(ctx, &msg_len, argv[0]);
		if (msg == NULL) return JS_EXCEPTION;
		NSLOG(netsurfy, INFO, "JS ALERT: %*s", (int)msg_len, msg);
		JS_FreeCString(ctx, msg);
	}
	return JS_UNDEFINED;
%}

method Window::setTimeout()
%{
	return window_set_timer(ctx, priv, false, argc, argv);
%}

method Window::setInterval()
%{
	return window_set_timer(ctx, priv, true, argc, argv);
%}

method Window::clearTimeout()
%{
	int64_t handle = 0;
	if (argc < 1 || JS_ToInt64(ctx, &handle, argv[0]) < 0 || handle <= 0) return JS_UNDEFINED;
	window_remove_callback_by_handle(ctx, priv, (size_t)handle);
	return JS_UNDEFINED;
%}

method Window::clearInterval()
%{
	int64_t handle = 0;
	if (argc < 1 || JS_ToInt64(ctx, &handle, argv[0]) < 0 || handle <= 0) return JS_UNDEFINED;
	window_remove_callback_by_handle(ctx, priv, (size_t)handle);
	return JS_UNDEFINED;
%}

method Window::requestAnimationFrame()
%{
	uint64_t now = 0;
	JSValue stamp;
	size_t handle;

	if (priv->closed_down == true || !JS_IsFunction(ctx, argv[0])) {
		return JS_UNDEFINED;
	}
	(void)nsu_getmonotonic_ms(&now);
	stamp = JS_NewFloat64(ctx, (double)now);
	handle = window_alloc_new_callback(ctx, priv, false, 16, argv[0], 1, &stamp);
	JS_FreeValue(ctx, stamp);
	return JS_NewInt64(ctx, (int64_t)handle);
%}

method Window::cancelAnimationFrame()
%{
	int64_t handle = 0;
	if (JS_ToInt64(ctx, &handle, argv[0]) < 0 || handle <= 0) return JS_UNDEFINED;
	window_remove_callback_by_handle(ctx, priv, (size_t)handle);
	return JS_UNDEFINED;
%}


getter Window::innerWidth()
%{
	int width, height;
	window_viewport(priv, &width, &height);
	return JS_NewInt32(ctx, (int32_t)(width / window_scale(priv)));
%}

getter Window::innerHeight()
%{
	int width, height;
	window_viewport(priv, &width, &height);
	return JS_NewInt32(ctx, (int32_t)(height / window_scale(priv)));
%}

getter Window::outerWidth()
%{
	int width, height;
	window_viewport(priv, &width, &height);
	return JS_NewInt32(ctx, width);
%}

getter Window::outerHeight()
%{
	int width, height;
	window_viewport(priv, &width, &height);
	return JS_NewInt32(ctx, height);
%}

getter Window::scrollX()
%{
	int sx, sy;
	window_scroll(priv, &sx, &sy);
	return JS_NewFloat64(ctx, sx / window_scale(priv));
%}

getter Window::pageXOffset()
%{
	int sx, sy;
	window_scroll(priv, &sx, &sy);
	return JS_NewFloat64(ctx, sx / window_scale(priv));
%}

getter Window::scrollY()
%{
	int sx, sy;
	window_scroll(priv, &sx, &sy);
	return JS_NewFloat64(ctx, sy / window_scale(priv));
%}

getter Window::pageYOffset()
%{
	int sx, sy;
	window_scroll(priv, &sx, &sy);
	return JS_NewFloat64(ctx, sy / window_scale(priv));
%}

getter Window::devicePixelRatio()
%{
	return JS_NewFloat64(ctx, window_scale(priv));
%}

method Window::scroll()
%{
	return window_scroll_to(ctx, priv, argc, argv, false);
%}

method Window::scrollTo()
%{
	return window_scroll_to(ctx, priv, argc, argv, false);
%}

method Window::scrollBy()
%{
	return window_scroll_to(ctx, priv, argc, argv, true);
%}

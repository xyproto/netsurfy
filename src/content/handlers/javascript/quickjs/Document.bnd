method Document::getElementsByClassName()
%{
	dom_nodelist *nodes = NULL;
	dom_exception err;
	dom_string *names;
	JSValue list;

	names = qjsky_to_dom_string(ctx, argv[0]);
	if (names == NULL) return JS_EXCEPTION;
	err = dom_node_get_elements_by_class_name((struct dom_node *)((node_private_t *)priv)->node, names, &nodes);
	dom_string_unref(names);
	if (err != DOM_NO_ERR || nodes == NULL) return JS_UNDEFINED;
	list = qjsky_node_list___create(ctx, nodes);
	dom_nodelist_unref(nodes);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}

getter Document::currentScript()
%{
	return qjsky_current_script(ctx);
%}

getter Document::images()
%{
	struct dom_html_collection *coll = NULL;
	JSValue list;

	if (!dom_document_is_html(((node_private_t *)priv)->node)) return JS_NULL;
	if (dom_html_document_get_images(((node_private_t *)priv)->node, &coll) != DOM_NO_ERR || coll == NULL) return JS_NULL;
	list = qjsky_html_collection___create(ctx, coll);
	dom_html_collection_unref(coll);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}


getter Document::forms()
%{
	struct dom_html_collection *coll = NULL;
	JSValue list;

	if (!dom_document_is_html(((node_private_t *)priv)->node)) {
		dom_nodelist *nodes = NULL;
		dom_exception err = dom_document_get_elements_by_tag_name_ns(
			priv->parent.node, corestring_dom_html_namespace, corestring_dom_form, &nodes);
		return document_list(ctx, err, nodes);
	}
	if (dom_html_document_get_forms(((node_private_t *)priv)->node, &coll) != DOM_NO_ERR || coll == NULL) return JS_NULL;
	list = qjsky_html_collection___create(ctx, coll);
	dom_html_collection_unref(coll);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}


prologue Document()
%{
#include <strings.h>
#include "utils/corestrings.h"
#include "utils/libdom.h"
#include "utils/utils.h"
#include "content/hlcache.h"
#include "html/private.h"
#include "content/urldb.h"

static struct html_content *document_htmlc(dom_node *node)
{
	struct html_content *htmlc = NULL;
	if (dom_node_get_user_data(node,
				   corestring_dom___ns_key_html_content_data,
				   &htmlc) != DOM_NO_ERR) {
		return NULL;
	}
	return htmlc;
}

static JSValue document_write(JSContext *ctx, dom_node *node, int argc, JSValueConst *argv, bool newline)
{
	struct html_content *htmlc = document_htmlc(node);

	if (htmlc == NULL) {
		NSLOG(tinysurf, INFO, "error getting htmlc. parent node:%p", node);
		return JS_UNDEFINED;
	}
	if (htmlc->parser == NULL) {
		NSLOG(tinysurf, INFO, "error; no parser for htmlc: %p", htmlc);
		return JS_UNDEFINED;
	}
	for (int i = 0; i < argc; i++) {
		size_t text_len;
		const char *text = JS_ToCStringLen(ctx, &text_len, argv[i]);
		if (text == NULL) {
			return JS_EXCEPTION;
		}
		dom_hubbub_parser_insert_chunk(htmlc->parser, (const uint8_t *)text, text_len);
		JS_FreeCString(ctx, text);
	}
	if (newline) {
		dom_hubbub_parser_insert_chunk(htmlc->parser, (const uint8_t *)"\n", 1);
	}
	return JS_UNDEFINED;
}

static JSValue document_node(JSContext *ctx, dom_exception err, dom_node *node)
{
	JSValue ret;
	if (err != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}
	ret = qjsky_node(ctx, node);
	if (node != NULL) {
		dom_node_unref(node);
	}
	return ret;
}

static JSValue document_new_node(JSContext *ctx, dom_exception err, dom_node *node)
{
	if (err != DOM_NO_ERR) {
		return qjsky_throw_dom(ctx, err);
	}
	return document_node(ctx, err, node);
}

static JSValue document_list(JSContext *ctx, dom_exception err, dom_nodelist *nodes)
{
	JSValue list;

	if (err != DOM_NO_ERR) {
		return qjsky_throw_dom(ctx, err);
	}
	if (nodes == NULL) {
		return JS_ThrowOutOfMemory(ctx);
	}
	list = qjsky_node_list___create(ctx, nodes);
	dom_nodelist_unref(nodes);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
}

static bool document_name_is(dom_node *node, const char *name)
{
	dom_string *local = NULL;
	bool match;

	if (dom_node_get_local_name(node, &local) != DOM_NO_ERR || local == NULL) {
		return false;
	}
	match = dom_string_byte_length(local) == strlen(name) &&
		strncasecmp(dom_string_data(local), name, strlen(name)) == 0;
	dom_string_unref(local);
	return match;
}

static JSValue document_html_child(JSContext *ctx, dom_node *doc, const char *name, const char *alt)
{
	dom_element *root = NULL;
	dom_node *child = NULL, *next;
	dom_node_type type;

	if (dom_document_get_document_element(doc, &root) != DOM_NO_ERR || root == NULL) {
		return JS_NULL;
	}
	if (!document_name_is((dom_node *)root, "html")) {
		dom_node_unref(root);
		return JS_NULL;
	}
	(void)dom_node_get_first_child(root, &child);
	dom_node_unref(root);
	while (child != NULL) {
		if (dom_node_get_node_type(child, &type) == DOM_NO_ERR && type == DOM_ELEMENT_NODE &&
		    (document_name_is(child, name) || (alt != NULL && document_name_is(child, alt)))) {
			return document_node(ctx, DOM_NO_ERR, child);
		}
		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR) {
			next = NULL;
		}
		dom_node_unref(child);
		child = next;
	}
	return JS_NULL;
}

static dom_node *document_title_element(dom_node *doc)
{
	struct dom_nodelist *nodes;
	struct dom_node *title = NULL;

	if (dom_document_get_elements_by_tag_name(doc, corestring_dom_TITLE, &nodes) != DOM_NO_ERR) {
		return NULL;
	}
	if (dom_nodelist_item(nodes, 0, &title) != DOM_NO_ERR) {
		title = NULL;
	}
	dom_nodelist_unref(nodes);
	if (title == NULL && dom_document_get_elements_by_tag_name_ns(doc, corestring_dom_html_namespace, corestring_dom_title, &nodes) == DOM_NO_ERR) {
		if (dom_nodelist_item(nodes, 0, &title) != DOM_NO_ERR) {
			title = NULL;
		}
		dom_nodelist_unref(nodes);
	}
	return title;
}

%}


init Document(struct dom_document *document::node);

method Document::write()
%{
	return document_write(ctx, priv->parent.node, argc, argv, false);
%}

method Document::writeln()
%{
	return document_write(ctx, priv->parent.node, argc, argv, true);
%}

method Document::createTextNode()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *text_str = qjsky_to_dom_string(ctx, argv[0]);

	if (text_str == NULL) return JS_EXCEPTION;
	err = dom_document_create_text_node(priv->parent.node, text_str, &newnode);
	dom_string_unref(text_str);
	return document_node(ctx, err, newnode);
%}

method Document::createElement()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *text_str = qjsky_to_dom_string(ctx, argv[0]);

	if (text_str == NULL) return JS_EXCEPTION;
	err = dom_document_create_element_ns(priv->parent.node,
					     dom_document_is_html(priv->parent.node) ? corestring_dom_html_namespace : NULL,
					     text_str,
					     &newnode);
	dom_string_unref(text_str);
	if (err != DOM_NO_ERR) {
		return qjsky_throw_dom(ctx, err);
	}
	return document_node(ctx, err, newnode);
%}

method Document::createElementNS()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *ns_str = NULL;
	dom_string *text_str;

	if (!JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
		ns_str = qjsky_to_dom_string(ctx, argv[0]);
		if (ns_str == NULL) return JS_EXCEPTION;
	}
	text_str = qjsky_to_dom_string(ctx, argv[1]);
	if (text_str == NULL) {
		if (ns_str != NULL) dom_string_unref(ns_str);
		return JS_EXCEPTION;
	}
	err = dom_document_create_element_ns(priv->parent.node, ns_str, text_str, &newnode);
	dom_string_unref(text_str);
	if (ns_str != NULL) dom_string_unref(ns_str);
	if (err != DOM_NO_ERR) {
		return qjsky_throw_dom(ctx, err);
	}
	return document_node(ctx, err, newnode);
%}

method Document::createRange()
%{
	return qjsky_range_create(ctx, priv->parent.node);
%}

method Document::createComment()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *data = qjsky_to_dom_string(ctx, argv[0]);

	if (data == NULL) return JS_EXCEPTION;
	err = dom_document_create_comment(priv->parent.node, data, &newnode);
	dom_string_unref(data);
	return document_new_node(ctx, err, newnode);
%}

method Document::createProcessingInstruction()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *target, *data;

	target = qjsky_to_dom_string(ctx, argv[0]);
	if (target == NULL) return JS_EXCEPTION;
	data = qjsky_to_dom_string(ctx, argv[1]);
	if (data == NULL) {
		dom_string_unref(target);
		return JS_EXCEPTION;
	}
	err = dom_document_create_processing_instruction(priv->parent.node, target, data, &newnode);
	dom_string_unref(target);
	dom_string_unref(data);
	return document_new_node(ctx, err, newnode);
%}

method Document::createAttribute()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *name = qjsky_to_dom_string(ctx, argv[0]);
	dom_string *lower = NULL;

	if (name == NULL) return JS_EXCEPTION;
	if (dom_string_tolower(name, true, &lower) == DOM_NO_ERR) {
		dom_string_unref(name);
		name = lower;
	}
	err = dom_document_create_attribute(priv->parent.node, name, &newnode);
	dom_string_unref(name);
	return document_new_node(ctx, err, newnode);
%}

method Document::createAttributeNS()
%{
	dom_node *newnode = NULL;
	dom_exception err;
	dom_string *ns, *qname;

	if (!qjsky_to_dom_namespace(ctx, argv[0], &ns)) return JS_EXCEPTION;
	qname = qjsky_to_dom_string(ctx, argv[1]);
	if (qname == NULL) {
		if (ns != NULL) dom_string_unref(ns);
		return JS_EXCEPTION;
	}
	err = dom_document_create_attribute_ns(priv->parent.node, ns, qname, &newnode);
	if (ns != NULL) dom_string_unref(ns);
	dom_string_unref(qname);
	return document_new_node(ctx, err, newnode);
%}

method Document::importNode()
%{
	node_private_t *np = qjsky_private(ctx, argv[0], QJSKY_IFACE_NODE);
	dom_node *newnode = NULL;
	dom_node_type type;
	dom_exception err;
	int deep = JS_ToBool(ctx, argv[1]);

	if (np == NULL) return JS_ThrowTypeError(ctx, "parameter 1 is not of type 'Node'");
	if (deep < 0) return JS_EXCEPTION;
	if (dom_node_get_node_type(np->node, &type) == DOM_NO_ERR && type == DOM_DOCUMENT_NODE) {
		return qjsky_throw_dom(ctx, DOM_NOT_SUPPORTED_ERR);
	}
	err = dom_document_import_node(priv->parent.node, np->node, deep != 0, &newnode);
	return document_new_node(ctx, err, newnode);
%}

method Document::adoptNode()
%{
	node_private_t *np = qjsky_private(ctx, argv[0], QJSKY_IFACE_NODE);
	dom_node *newnode = NULL;
	dom_node_type type;
	dom_exception err;

	if (np == NULL) return JS_ThrowTypeError(ctx, "parameter 1 is not of type 'Node'");
	if (dom_node_get_node_type(np->node, &type) == DOM_NO_ERR && type == DOM_DOCUMENT_NODE) {
		return qjsky_throw_dom(ctx, DOM_NOT_SUPPORTED_ERR);
	}
	err = dom_document_adopt_node(priv->parent.node, np->node, &newnode);
	return document_new_node(ctx, err, newnode);
%}

method Document::getElementsByTagNameNS()
%{
	dom_nodelist *nodes = NULL;
	dom_string *ns, *local;
	dom_exception err;

	if (!qjsky_to_dom_namespace(ctx, argv[0], &ns)) return JS_EXCEPTION;
	local = qjsky_to_dom_string(ctx, argv[1]);
	if (local == NULL) {
		if (ns != NULL) dom_string_unref(ns);
		return JS_EXCEPTION;
	}
	err = dom_document_get_elements_by_tag_name_ns(priv->parent.node, ns, local, &nodes);
	if (ns != NULL) dom_string_unref(ns);
	dom_string_unref(local);
	return document_list(ctx, err, nodes);
%}

method Document::createDocumentFragment()
%{
	struct dom_document_fragment *frag = NULL;
	dom_exception err;

	err = dom_document_create_document_fragment(priv->parent.node, &frag);
	return document_node(ctx, err, (dom_node *)frag);
%}

getter Document::title()
%{
	dom_node *title = document_title_element(priv->parent.node);
	dom_string *text = NULL;
	const char *src;
	char *out;
	size_t len, outlen = 0;
	bool space = false;
	JSValue ret;

	if (title == NULL) {
		return JS_NewString(ctx, "");
	}
	if (dom_node_get_text_content(title, &text) != DOM_NO_ERR || text == NULL) {
		dom_node_unref(title);
		return JS_NewString(ctx, "");
	}
	dom_node_unref(title);
	src = dom_string_data(text);
	len = dom_string_byte_length(text);
	out = malloc(len + 1);
	if (out == NULL) {
		dom_string_unref(text);
		return JS_ThrowOutOfMemory(ctx);
	}
	for (size_t i = 0; i < len; i++) {
		char c = src[i];
		if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f') {
			space = outlen > 0;
			continue;
		}
		if (space) {
			out[outlen++] = ' ';
			space = false;
		}
		out[outlen++] = c;
	}
	ret = JS_NewStringLen(ctx, out, outlen);
	free(out);
	dom_string_unref(text);
	return ret;
%}

setter Document::title()
%{
	dom_node *title = document_title_element(priv->parent.node);
	dom_string *text;

	if (title == NULL) {
		return JS_UNDEFINED;
	}
	text = qjsky_to_dom_string(ctx, argv[0]);
	if (text == NULL) {
		dom_node_unref(title);
		return JS_EXCEPTION;
	}
	(void)dom_node_set_text_content(title, text);
	dom_string_unref(text);
	dom_node_unref(title);
	return JS_UNDEFINED;
%}

getter Document::head()
%{
	return document_html_child(ctx, priv->parent.node, "head", NULL);
%}

getter Document::body()
%{
	return document_html_child(ctx, priv->parent.node, "body", "frameset");
%}

getter Document::doctype()
%{
	struct dom_document_type *doctype = NULL;
	JSValue ret;
	if (dom_document_get_doctype(priv->parent.node, &doctype) != DOM_NO_ERR || doctype == NULL) return JS_NULL;
	ret = qjsky_node(ctx, (dom_node *)doctype);
	dom_node_unref(doctype);
	return ret;
%}

getter Document::compatMode()
%{
	dom_document_quirks_mode mode = DOM_DOCUMENT_QUIRKS_MODE_NONE;
	(void)dom_document_get_quirks_mode(priv->parent.node, &mode);
	return JS_NewString(ctx, mode == DOM_DOCUMENT_QUIRKS_MODE_FULL ? "BackCompat" : "CSS1Compat");
%}

getter Document::characterSet()
%{
	struct html_content *htmlc = document_htmlc(priv->parent.node);
	if (htmlc == NULL || htmlc->encoding == NULL) return JS_NewString(ctx, "UTF-8");
	return JS_NewString(ctx, htmlc->encoding);
%}

getter Document::inputEncoding()
%{
	struct html_content *htmlc = document_htmlc(priv->parent.node);
	if (htmlc == NULL || htmlc->encoding == NULL) return JS_NewString(ctx, "UTF-8");
	return JS_NewString(ctx, htmlc->encoding);
%}

getter Document::contentType()
%{
	return JS_NewString(ctx, document_htmlc(priv->parent.node) != NULL ? "text/html" : "application/xml");
%}

getter Document::defaultView()
%{
	if (document_htmlc(priv->parent.node) == NULL) return JS_NULL;
	return JS_GetGlobalObject(ctx);
%}

getter Document::location()
%{
	JSValue global = JS_GetGlobalObject(ctx);
	JSValue loc = JS_GetPropertyStr(ctx, global, "location");
	JS_FreeValue(ctx, global);
	return loc;
%}

method Document::getElementById()
%{
	dom_string *elementId_dom;
	dom_element *element = NULL;
	dom_exception exc;

	elementId_dom = qjsky_to_dom_string(ctx, argv[0]);
	if (elementId_dom == NULL) return JS_EXCEPTION;
	exc = dom_document_get_element_by_id(((node_private_t *)priv)->node,
					     elementId_dom, &element);
	dom_string_unref(elementId_dom);
	return document_node(ctx, exc, (dom_node *)element);
%}

getter Document::documentElement()
%{
	dom_element *element = NULL;
	dom_exception exc;

	exc = dom_document_get_document_element(((node_private_t *)priv)->node, &element);
	return document_node(ctx, exc, (dom_node *)element);
%}

method Document::getElementsByTagName()
%{
	dom_nodelist *nodes = NULL;
	dom_exception err;
	dom_string *tag;
	JSValue list;

	tag = qjsky_to_dom_string(ctx, argv[0]);
	if (tag == NULL) return JS_EXCEPTION;
	err = dom_document_get_elements_by_tag_name(((node_private_t *)priv)->node, tag, &nodes);
	dom_string_unref(tag);
	if (err != DOM_NO_ERR || nodes == NULL) return JS_UNDEFINED;
	list = qjsky_node_list___create(ctx, nodes);
	dom_nodelist_unref(nodes);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}

getter Document::referrer()
%{
	struct html_content *htmlc = document_htmlc(priv->parent.node);
	nsurl *referer = htmlc != NULL ? llcache_handle_get_referer(htmlc->base.llcache) : NULL;

	return JS_NewString(ctx, referer != NULL ? nsurl_access(referer) : "");
%}

getter Document::cookie()
%{
	char *cookie_str;
	JSValue ret;
	struct html_content *htmlc = document_htmlc(priv->parent.node);

	if (htmlc == NULL) {
		NSLOG(tinysurf, INFO, "error getting htmlc. parent node:%p", priv->parent.node);
		return JS_UNDEFINED;
	}
	cookie_str = urldb_get_cookie(llcache_handle_get_url(htmlc->base.llcache), false);
	if (cookie_str == NULL) {
		return JS_NewString(ctx, "");
	}
	ret = JS_NewString(ctx, cookie_str);
	free(cookie_str);
	return ret;
%}

setter Document::cookie()
%{
	struct html_content *htmlc = document_htmlc(priv->parent.node);
	const char *cookie_str;

	if (htmlc == NULL) {
		NSLOG(tinysurf, INFO, "error getting htmlc. parent node:%p", priv->parent.node);
		return JS_UNDEFINED;
	}
	cookie_str = JS_ToCString(ctx, argv[0]);
	if (cookie_str == NULL) return JS_EXCEPTION;
	if (!urldb_set_cookie(cookie_str,
			      llcache_handle_get_url(htmlc->base.llcache),
			      NULL)) {
		NSLOG(tinysurf, DEEPDEBUG, "unable to set cookie: %s", cookie_str);
	}
	JS_FreeCString(ctx, cookie_str);
	return JS_UNDEFINED;
%}

method Document::createEvent ()
%{
	dom_event *evt = NULL;
	dom_string *type;
	dom_exception exc;
	JSValue ret;

	if (argc < 1) return JS_ThrowTypeError(ctx, "createEvent: 1 argument required");
	type = qjsky_to_dom_string(ctx, argv[0]);
	if (type == NULL) return JS_EXCEPTION;
	exc = dom_document_event_create_event(priv->parent.node, type, &evt);
	dom_string_unref(type);
	if (exc != DOM_NO_ERR || evt == NULL) return JS_ThrowOutOfMemory(ctx);
	(void)dom_event_set_is_trusted(evt, false);
	ret = qjsky_event(ctx, evt);
	dom_event_unref(evt);
	return ret;
%}

getter Document::implementation ()
%{
	JSValue impl = qjsky_hidden_get(ctx, this_val, QJSKY_HIDDEN_DOM_IMPLEMENTATION, false);
	if (!JS_IsUndefined(impl)) return impl;
	impl = qjsky_dom_implementation___create(ctx);
	if (JS_IsException(impl)) return impl;
	qjsky_hidden_set(ctx, this_val, QJSKY_HIDDEN_DOM_IMPLEMENTATION, JS_DupValue(ctx, impl));
	return impl;
%}


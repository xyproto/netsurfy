class DOMPointReadOnly {
	prologue %{
#include <math.h>
%};
	private double x;
	private double y;
	private double z;
	private double w;
};

init DOMPointReadOnly(double x, double y, double z, double w)
%{
	priv->x = x;
	priv->y = y;
	priv->z = z;
	priv->w = w;
%}

constructor DOMPointReadOnly()
%{
	double v[4] = {0, 0, 0, 1};

	if (qjsky_geometry_args(ctx, argc, argv, v, 4) < 0) return JS_EXCEPTION;
	return qjsky_constructed(ctx, qjsky_dom_point_read_only___create(ctx, v[0], v[1], v[2], v[3]), new_target);
%}

getter DOMPointReadOnly::x()
%{
	return JS_NewFloat64(ctx, priv->x);
%}

getter DOMPointReadOnly::y()
%{
	return JS_NewFloat64(ctx, priv->y);
%}

getter DOMPointReadOnly::z()
%{
	return JS_NewFloat64(ctx, priv->z);
%}

getter DOMPointReadOnly::w()
%{
	return JS_NewFloat64(ctx, priv->w);
%}

method DOMPointReadOnly::matrixTransform()
%{
	qjsky_matrix mat;
	double in[4] = {priv->x, priv->y, priv->z, priv->w}, res[4];

	if (qjsky_matrix_from_js(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &mat) < 0) return JS_EXCEPTION;
	qjsky_matrix_transform(&mat, in, res);
	return qjsky_dom_point___create(ctx, res[0], res[1], res[2], res[3]);
%}

method DOMPointReadOnly::toJSON()
%{
	static const char *const names[4] = {"x", "y", "z", "w"};
	double v[4] = {priv->x, priv->y, priv->z, priv->w};

	return qjsky_geometry_json(ctx, names, v, 4);
%}

init DOMPoint(double x::x, double y::y, double z::z, double w::w);

constructor DOMPoint()
%{
	double v[4] = {0, 0, 0, 1};

	if (qjsky_geometry_args(ctx, argc, argv, v, 4) < 0) return JS_EXCEPTION;
	return qjsky_constructed(ctx, qjsky_dom_point___create(ctx, v[0], v[1], v[2], v[3]), new_target);
%}

getter DOMPoint::x()
%{
	return JS_NewFloat64(ctx, priv->parent.x);
%}

setter DOMPoint::x()
%{
	if (JS_ToFloat64(ctx, &priv->parent.x, argv[0]) < 0) return JS_EXCEPTION;
	return JS_UNDEFINED;
%}

getter DOMPoint::y()
%{
	return JS_NewFloat64(ctx, priv->parent.y);
%}

setter DOMPoint::y()
%{
	if (JS_ToFloat64(ctx, &priv->parent.y, argv[0]) < 0) return JS_EXCEPTION;
	return JS_UNDEFINED;
%}

getter DOMPoint::z()
%{
	return JS_NewFloat64(ctx, priv->parent.z);
%}

setter DOMPoint::z()
%{
	if (JS_ToFloat64(ctx, &priv->parent.z, argv[0]) < 0) return JS_EXCEPTION;
	return JS_UNDEFINED;
%}

getter DOMPoint::w()
%{
	return JS_NewFloat64(ctx, priv->parent.w);
%}

setter DOMPoint::w()
%{
	if (JS_ToFloat64(ctx, &priv->parent.w, argv[0]) < 0) return JS_EXCEPTION;
	return JS_UNDEFINED;
%}

class DOMRectReadOnly {
	prologue %{
#include <math.h>
%};
	private double x;
	private double y;
	private double width;
	private double height;
};

init DOMRectReadOnly(double x, double y, double width, double height)
%{
	priv->x = x;
	priv->y = y;
	priv->width = width;
	priv->height = height;
%}

constructor DOMRectReadOnly()
%{
	double v[4] = {0, 0, 0, 0};

	if (qjsky_geometry_args(ctx, argc, argv, v, 4) < 0) return JS_EXCEPTION;
	return qjsky_constructed(ctx, qjsky_dom_rect_read_only___create(ctx, v[0], v[1], v[2], v[3]), new_target);
%}

getter DOMRectReadOnly::x()
%{
	return JS_NewFloat64(ctx, priv->x);
%}

getter DOMRectReadOnly::y()
%{
	return JS_NewFloat64(ctx, priv->y);
%}

getter DOMRectReadOnly::width()
%{
	return JS_NewFloat64(ctx, priv->width);
%}

getter DOMRectReadOnly::height()
%{
	return JS_NewFloat64(ctx, priv->height);
%}

getter DOMRectReadOnly::top()
%{
	return JS_NewFloat64(ctx, fmin(priv->y, priv->y + priv->height));
%}

getter DOMRectReadOnly::right()
%{
	return JS_NewFloat64(ctx, fmax(priv->x, priv->x + priv->width));
%}

getter DOMRectReadOnly::bottom()
%{
	return JS_NewFloat64(ctx, fmax(priv->y, priv->y + priv->height));
%}

getter DOMRectReadOnly::left()
%{
	return JS_NewFloat64(ctx, fmin(priv->x, priv->x + priv->width));
%}

method DOMRectReadOnly::toJSON()
%{
	static const char *const names[8] = {"x", "y", "width", "height", "top", "right", "bottom", "left"};
	double v[8] = {priv->x, priv->y, priv->width, priv->height,
		       fmin(priv->y, priv->y + priv->height), fmax(priv->x, priv->x + priv->width),
		       fmax(priv->y, priv->y + priv->height), fmin(priv->x, priv->x + priv->width)};

	return qjsky_geometry_json(ctx, names, v, 8);
%}


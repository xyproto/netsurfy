class DOMMatrixReadOnly {
	prologue %{
#include <math.h>
%};
	private struct qjsky_matrix mat;
};

init DOMMatrixReadOnly(struct qjsky_matrix *mat)
%{
	priv->mat = *mat;
%}

constructor DOMMatrixReadOnly()
%{
	qjsky_matrix mat;

	if (qjsky_matrix_from_init(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &mat) < 0) return JS_EXCEPTION;
	return qjsky_constructed(ctx, qjsky_dom_matrix_read_only___create(ctx, &mat), new_target);
%}

getter DOMMatrixReadOnly::a()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 1));
%}

getter DOMMatrixReadOnly::b()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 2));
%}

getter DOMMatrixReadOnly::c()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 1));
%}

getter DOMMatrixReadOnly::d()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 2));
%}

getter DOMMatrixReadOnly::e()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 1));
%}

getter DOMMatrixReadOnly::f()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 2));
%}

getter DOMMatrixReadOnly::m11()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 1));
%}

getter DOMMatrixReadOnly::m12()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 2));
%}

getter DOMMatrixReadOnly::m13()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 3));
%}

getter DOMMatrixReadOnly::m14()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 1, 4));
%}

getter DOMMatrixReadOnly::m21()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 1));
%}

getter DOMMatrixReadOnly::m22()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 2));
%}

getter DOMMatrixReadOnly::m23()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 3));
%}

getter DOMMatrixReadOnly::m24()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 2, 4));
%}

getter DOMMatrixReadOnly::m31()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 3, 1));
%}

getter DOMMatrixReadOnly::m32()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 3, 2));
%}

getter DOMMatrixReadOnly::m33()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 3, 3));
%}

getter DOMMatrixReadOnly::m34()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 3, 4));
%}

getter DOMMatrixReadOnly::m41()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 1));
%}

getter DOMMatrixReadOnly::m42()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 2));
%}

getter DOMMatrixReadOnly::m43()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 3));
%}

getter DOMMatrixReadOnly::m44()
%{
	return JS_NewFloat64(ctx, *qjsky_matrix_entry(&priv->mat, 4, 4));
%}

getter DOMMatrixReadOnly::is2D()
%{
	return JS_NewBool(ctx, priv->mat.is2d);
%}

getter DOMMatrixReadOnly::isIdentity()
%{
	return JS_NewBool(ctx, qjsky_matrix_is_identity(&priv->mat));
%}

method DOMMatrixReadOnly::translate()
%{
	qjsky_matrix mat = priv->mat;

	if (JS_IsException(qjsky_matrix_translate_args(ctx, argc, argv, &mat))) return JS_EXCEPTION;
	return qjsky_dom_matrix___create(ctx, &mat);
%}

method DOMMatrixReadOnly::scale()
%{
	qjsky_matrix mat = priv->mat;

	if (JS_IsException(qjsky_matrix_scale_args(ctx, argc, argv, &mat))) return JS_EXCEPTION;
	return qjsky_dom_matrix___create(ctx, &mat);
%}

method DOMMatrixReadOnly::multiply()
%{
	qjsky_matrix other, mat;

	if (qjsky_matrix_from_js(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &other) < 0) return JS_EXCEPTION;
	qjsky_matrix_multiply(&mat, &priv->mat, &other);
	return qjsky_dom_matrix___create(ctx, &mat);
%}

method DOMMatrixReadOnly::inverse()
%{
	qjsky_matrix mat;

	qjsky_matrix_invert(&mat, &priv->mat);
	return qjsky_dom_matrix___create(ctx, &mat);
%}

method DOMMatrixReadOnly::transformPoint()
%{
	double in[4], res[4];

	if (qjsky_geometry_point_from_js(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, in) < 0) return JS_EXCEPTION;
	qjsky_matrix_transform(&priv->mat, in, res);
	return qjsky_dom_point___create(ctx, res[0], res[1], res[2], res[3]);
%}

method DOMMatrixReadOnly::toString()
%{
	return qjsky_matrix_to_string(ctx, &priv->mat);
%}

method DOMMatrixReadOnly::toJSON()
%{
	static const char *const names[22] = {"a", "b", "c", "d", "e", "f",
		"m11", "m12", "m13", "m14", "m21", "m22", "m23", "m24",
		"m31", "m32", "m33", "m34", "m41", "m42", "m43", "m44"};
	double v[22];
	JSValue obj;
	int k = 0;
	static const int ab[6][2] = {{1, 1}, {1, 2}, {2, 1}, {2, 2}, {4, 1}, {4, 2}};

	for (int n = 0; n < 6; n++) v[k++] = *qjsky_matrix_entry(&priv->mat, ab[n][0], ab[n][1]);
	for (int i = 1; i <= 4; i++) {
		for (int j = 1; j <= 4; j++) v[k++] = *qjsky_matrix_entry(&priv->mat, i, j);
	}
	obj = qjsky_geometry_json(ctx, names, v, 22);
	if (JS_IsException(obj)) return obj;
	JS_SetPropertyStr(ctx, obj, "is2D", JS_NewBool(ctx, priv->mat.is2d));
	JS_SetPropertyStr(ctx, obj, "isIdentity", JS_NewBool(ctx, qjsky_matrix_is_identity(&priv->mat)));
	return obj;
%}

init DOMMatrix(struct qjsky_matrix *mat::mat);

constructor DOMMatrix()
%{
	qjsky_matrix mat;

	if (qjsky_matrix_from_init(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &mat) < 0) return JS_EXCEPTION;
	return qjsky_constructed(ctx, qjsky_dom_matrix___create(ctx, &mat), new_target);
%}


%}

setter DOMMatrix::m11()
%{
	if (JS_ToFloat64(ctx, qjsky_matrix_entry(&priv->parent.mat, 1, 1), argv[0]) < 0) return JS_EXCEPTION;
	if (*qjsky_matrix_entry(&priv->parent.mat, 1, 1) != 1) priv->parent.mat.is2d = false;

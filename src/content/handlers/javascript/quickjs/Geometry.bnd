method DOMMatrix::multiplySelf()
%{
	qjsky_matrix other;

	if (qjsky_matrix_from_js(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &other) < 0) return JS_EXCEPTION;
	qjsky_matrix_multiply(&priv->parent.mat, &priv->parent.mat, &other);
	return JS_DupValue(ctx, this_val);
%}

method DOMMatrix::preMultiplySelf()
%{
	qjsky_matrix other;

	if (qjsky_matrix_from_js(ctx, argc > 0 ? argv[0] : JS_UNDEFINED, &other) < 0) return JS_EXCEPTION;
	qjsky_matrix_multiply(&priv->parent.mat, &other, &priv->parent.mat);
	return JS_DupValue(ctx, this_val);
%}

method DOMMatrix::translateSelf()
%{
	if (JS_IsException(qjsky_matrix_translate_args(ctx, argc, argv, &priv->parent.mat))) return JS_EXCEPTION;
	return JS_DupValue(ctx, this_val);
%}

method DOMMatrix::scaleSelf()
%{
	if (JS_IsException(qjsky_matrix_scale_args(ctx, argc, argv, &priv->parent.mat))) return JS_EXCEPTION;
	return JS_DupValue(ctx, this_val);
%}

method DOMMatrix::invertSelf()
%{
	qjsky_matrix_invert(&priv->parent.mat, &priv->parent.mat);
	return JS_DupValue(ctx, this_val);
%}

class Element {
	prologue %{
#include <utils/corestrings.h>
#include <dom/bindings/hubbub/parser.h>

typedef dom_exception (*element_step_fn)(dom_node *node, dom_node **result);

static JSValue element_walk(JSContext *ctx, dom_node *start, element_step_fn first, element_step_fn next)
{
	dom_node *element = NULL;
	dom_node *step;
	dom_node_type node_type;
	JSValue ret;

	if (first(start, &element) != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}
	while (element != NULL) {
		if ((dom_node_get_node_type(element, &node_type) == DOM_NO_ERR) &&
		    (node_type == DOM_ELEMENT_NODE)) {
			break;
		}
		if (next(element, &step) != DOM_NO_ERR) {
			step = NULL;
		}
		dom_node_unref(element);
		element = step;
	}
	ret = qjsky_node(ctx, element);
	if (element != NULL) {
		dom_node_unref(element);
	}
	return ret;
}

static JSValue element_get_attribute_string(JSContext *ctx, dom_node *node, dom_string *name)
{
	dom_string *str = NULL;
	JSValue ret;

	if (dom_element_get_attribute(node, name, &str) != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}
	if (str == NULL) {
		return JS_NewString(ctx, "");
	}
	ret = qjsky_string(ctx, str);
	dom_string_unref(str);
	return ret;
}

static JSValue element_node_result(JSContext *ctx, dom_exception exc, dom_node *node)
{
	JSValue ret;

	if (exc != DOM_NO_ERR) {
		return qjsky_throw_dom(ctx, exc);
	}
	ret = qjsky_node(ctx, node);
	if (node != NULL) {
		dom_node_unref(node);
	}
	return ret;
}

static dom_node *element_attr_arg(JSContext *ctx, JSValueConst val)
{
	node_private_t *np = qjsky_private(ctx, val, QJSKY_IFACE_NODE);
	dom_node_type type;

	if (np == NULL || dom_node_get_node_type(np->node, &type) != DOM_NO_ERR || type != DOM_ATTRIBUTE_NODE) {
		JS_ThrowTypeError(ctx, "parameter 1 is not of type 'Attr'");
		return NULL;
	}
	return np->node;
}

static bool element_ns_args(JSContext *ctx, JSValueConst *argv, dom_string **ns, dom_string **name)
{
	if (!qjsky_to_dom_namespace(ctx, argv[0], ns)) {
		return false;
	}
	*name = qjsky_to_dom_string(ctx, argv[1]);
	if (*name == NULL) {
		if (*ns != NULL) {
			dom_string_unref(*ns);
		}
		return false;
	}
	return true;
}

static void element_ns_free(dom_string *ns, dom_string *name)
{
	if (ns != NULL) {
		dom_string_unref(ns);
	}
	dom_string_unref(name);
}

JSValue qjsky_element_token_list(JSContext *ctx, JSValueConst this_val, dom_node *node, dom_string *attr, int hidden)
{
	dom_tokenlist *tokens;
	JSValue list;

	list = qjsky_hidden_get(ctx, this_val, hidden, false);
	if (!JS_IsUndefined(list)) {
		return list;
	}
	if (dom_tokenlist_create((dom_element *)node, attr, &tokens) != DOM_NO_ERR) {
		return JS_ThrowOutOfMemory(ctx);
	}
	list = qjsky_dom_settable_token_list___create(ctx, tokens);
	dom_tokenlist_unref(tokens);
	if (JS_IsException(list)) {
		return list;
	}
	qjsky_hidden_set(ctx, this_val, hidden, JS_DupValue(ctx, list));
	return list;
}

JSValue qjsky_rel_list(JSContext *ctx, JSValueConst this_val, dom_node *node)
{
	return qjsky_element_token_list(ctx, this_val, node, corestring_dom_rel, QJSKY_HIDDEN_REL_LIST);
}

static JSValue element_set_attribute_string(JSContext *ctx, dom_node *node, dom_string *name, JSValueConst val)
{
	dom_string *str = qjsky_to_dom_string(ctx, val);

	if (str == NULL) {
		return JS_EXCEPTION;
	}
	(void)dom_element_set_attribute(node, name, str);
	dom_string_unref(str);
	return JS_UNDEFINED;
}
%};
};

init Element(struct dom_element *element::node);

getter Element::tagName();

getter Element::namespaceURI()
%{
	dom_string *str = NULL;
	JSValue ret;
	if (dom_node_get_namespace(((node_private_t *)priv)->node, &str) != DOM_NO_ERR || str == NULL) return JS_NULL;
	ret = qjsky_string(ctx, str);
	dom_string_unref(str);
	return ret;
%}

getter Element::prefix()
%{
	dom_string *str = NULL;
	JSValue ret;
	if (dom_node_get_prefix(((node_private_t *)priv)->node, &str) != DOM_NO_ERR || str == NULL) return JS_NULL;
	ret = qjsky_string(ctx, str);
	dom_string_unref(str);
	return ret;
%}

getter Element::localName()
%{
	dom_string *str = NULL;
	JSValue ret;
	dom_string *ns = NULL;
	if (dom_node_get_local_name(((node_private_t *)priv)->node, &str) != DOM_NO_ERR || str == NULL) return JS_NULL;
	if (dom_node_get_namespace(((node_private_t *)priv)->node, &ns) == DOM_NO_ERR && ns != NULL) {
		if (dom_string_byte_length(ns) == (sizeof("http://www.w3.org/1999/xhtml") - 1) &&
		    memcmp(dom_string_data(ns), "http://www.w3.org/1999/xhtml", (sizeof("http://www.w3.org/1999/xhtml") - 1)) == 0) {
			dom_string *lower = NULL;
			if (dom_string_tolower(str, true, &lower) == DOM_NO_ERR) {
				dom_string_unref(str);
				str = lower;
			}
		}
		dom_string_unref(ns);
	}
	ret = qjsky_string(ctx, str);
	dom_string_unref(str);
	return ret;
%}

getter Element::firstElementChild()
%{
	return element_walk(ctx, ((node_private_t *)priv)->node,
			    dom_node_get_first_child, dom_node_get_next_sibling);
%}

getter Element::lastElementChild()
%{
	return element_walk(ctx, ((node_private_t *)priv)->node,
			    dom_node_get_last_child, dom_node_get_previous_sibling);
%}

getter Element::previousElementSibling()
%{
	return element_walk(ctx, ((node_private_t *)priv)->node,
			    dom_node_get_previous_sibling, dom_node_get_previous_sibling);
%}

getter Element::nextElementSibling()
%{
	return element_walk(ctx, ((node_private_t *)priv)->node,
			    dom_node_get_next_sibling, dom_node_get_next_sibling);
%}

getter Element::childElementCount()
%{
	dom_node *element;
	dom_node_type node_type;
	dom_node *next_node;
	uint32_t count = 0;

	if (dom_node_get_first_child(((node_private_t *)priv)->node, &element) != DOM_NO_ERR) {
		return JS_UNDEFINED;
	}
	while (element != NULL) {
		if ((dom_node_get_node_type(element, &node_type) == DOM_NO_ERR) &&
		    (node_type == DOM_ELEMENT_NODE)) {
			count += 1;
		}
		if (dom_node_get_next_sibling(element, &next_node) != DOM_NO_ERR) {
			next_node = NULL;
		}
		dom_node_unref(element);
		element = next_node;
	}
	return JS_NewUint32(ctx, count);
%}

method Element::getElementsByTagName ()
%{
	dom_nodelist *nlist = NULL;
	dom_string *tagname;
	dom_exception exc;
	JSValue list;

	tagname = qjsky_to_dom_string(ctx, argv[0]);
	if (tagname == NULL) return JS_EXCEPTION;
	exc = dom_element_get_elements_by_tag_name(priv->parent.node, tagname, &nlist);
	dom_string_unref(tagname);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;
	list = qjsky_node_list___create(ctx, nlist);
	dom_nodelist_unref(nlist);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}

getter Element::id ()
%{
	return element_get_attribute_string(ctx, priv->parent.node, corestring_dom_id);
%}

setter Element::id ()
%{
	return element_set_attribute_string(ctx, priv->parent.node, corestring_dom_id, argv[0]);
%}

method Element::removeAttribute()
%{
	dom_string *attr = qjsky_to_dom_string(ctx, argv[0]);
	if (attr == NULL) return JS_EXCEPTION;
	(void)dom_element_remove_attribute(priv->parent.node, attr);
	dom_string_unref(attr);
	return JS_UNDEFINED;
%}

method Element::getAttribute()
%{
	dom_string *attr_name;
	dom_string *attr_value = NULL;
	dom_exception exc;
	JSValue ret;

	attr_name = qjsky_to_dom_string(ctx, argv[0]);
	if (attr_name == NULL) return JS_EXCEPTION;
	exc = dom_element_get_attribute(priv->parent.node, attr_name, &attr_value);
	dom_string_unref(attr_name);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;
	if (attr_value == NULL) return JS_NULL;
	ret = qjsky_string(ctx, attr_value);
	dom_string_unref(attr_value);
	return ret;
%}

method Element::setAttribute()
%{
	dom_string *attr_str, *value_str;

	attr_str = qjsky_to_dom_string(ctx, argv[0]);
	if (attr_str == NULL) return JS_EXCEPTION;
	value_str = qjsky_to_dom_string(ctx, argv[1]);
	if (value_str == NULL) {
		dom_string_unref(attr_str);
		return JS_EXCEPTION;
	}
	(void)dom_element_set_attribute(priv->parent.node, attr_str, value_str);
	dom_string_unref(attr_str);
	dom_string_unref(value_str);
	return JS_UNDEFINED;
%}

method Element::hasAttribute()
%{
	dom_string *attr_name;
	dom_exception exc;
	bool res;

	attr_name = qjsky_to_dom_string(ctx, argv[0]);
	if (attr_name == NULL) return JS_EXCEPTION;
	exc = dom_element_has_attribute(priv->parent.node, attr_name, &res);
	dom_string_unref(attr_name);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewBool(ctx, res);
%}

getter Element::className ()
%{
	return element_get_attribute_string(ctx, priv->parent.node, corestring_dom_class);
%}

setter Element::className ()
%{
	return element_set_attribute_string(ctx, priv->parent.node, corestring_dom_class, argv[0]);
%}

getter Element::classList ()
%{
	return qjsky_element_token_list(ctx, this_val, priv->parent.node, corestring_dom_class, QJSKY_HIDDEN_CLASS_LIST);
%}

getter Element::innerHTML()
%{
	return JS_NewString(ctx, "");
%}

setter Element::innerHTML()
%{
	size_t size;
	const char *s;
	dom_hubbub_parser_params parse_params;
	dom_hubbub_error error;
	dom_hubbub_parser *parser = NULL;
	struct dom_document *doc = NULL;
	struct dom_document_fragment *fragment = NULL;
	dom_exception exc;
	struct dom_node *child = NULL, *html = NULL, *body = NULL;
	struct dom_nodelist *bodies = NULL;

	s = JS_ToCStringLen(ctx, &size, argv[0]);
	if (s == NULL) return JS_EXCEPTION;

	exc = dom_node_get_owner_document(priv->parent.node, &doc);
	if (exc != DOM_NO_ERR) goto out;

	parse_params.enc = "UTF-8";
	parse_params.fix_enc = true;
	parse_params.enable_script = false;
	parse_params.msg = NULL;
	parse_params.script = NULL;
	parse_params.ctx = NULL;
	parse_params.daf = NULL;

	error = dom_hubbub_fragment_parser_create(&parse_params,
						  doc,
						  &parser,
						  &fragment);
	if (error != DOM_HUBBUB_OK) {
		NSLOG(netsurfy, ERROR, "Unable to create fragment parser!");
		goto out;
	}

	error = dom_hubbub_parser_parse_chunk(parser, (const uint8_t*)s, size);
	if (error != DOM_HUBBUB_OK) {
		NSLOG(netsurfy, ERROR, "Unable to parse HTML chunk");
		goto out;
	}
	error = dom_hubbub_parser_completed(parser);
	if (error != DOM_HUBBUB_OK) {
		NSLOG(netsurfy, ERROR, "Unable to complete parser");
		goto out;
	}

	exc = dom_node_get_first_child(priv->parent.node, &child);
	if (exc != DOM_NO_ERR) goto out;
	while (child != NULL) {
		struct dom_node *cref;
		exc = dom_node_remove_child(priv->parent.node, child, &cref);
		if (exc != DOM_NO_ERR) goto out;
		dom_node_unref(child);
		child = NULL;
		dom_node_unref(cref);
		exc = dom_node_get_first_child(priv->parent.node, &child);
		if (exc != DOM_NO_ERR) goto out;
	}

	exc = dom_node_get_first_child(fragment, &html);
	if (exc != DOM_NO_ERR) goto out;

	exc = dom_element_get_elements_by_tag_name(html, corestring_dom_BODY, &bodies);
	if (exc != DOM_NO_ERR) goto out;

	exc = dom_nodelist_item(bodies, 0, &body);
	if (exc != DOM_NO_ERR) goto out;

	exc = dom_node_get_first_child(body, &child);
	if (exc != DOM_NO_ERR) goto out;
	while (child != NULL) {
		struct dom_node *cref;
		exc = dom_node_remove_child(body, child, &cref);
		if (exc != DOM_NO_ERR) goto out;
		dom_node_unref(cref);
		exc = dom_node_append_child(priv->parent.node, child, &cref);
		if (exc != DOM_NO_ERR) goto out;
		dom_node_unref(cref);
		dom_node_unref(child);
		child = NULL;
		exc = dom_node_get_first_child(body, &child);
		if (exc != DOM_NO_ERR) goto out;
	}
out:
	JS_FreeCString(ctx, s);
	if (parser != NULL) {
		dom_hubbub_parser_destroy(parser);
	}
	if (doc != NULL) {
		dom_node_unref(doc);
	}
	if (fragment != NULL) {
		dom_node_unref(fragment);
	}
	if (child != NULL) {
		dom_node_unref(child);
	}
	if (html != NULL) {
		dom_node_unref(html);
	}
	if (bodies != NULL) {
		dom_nodelist_unref(bodies);
	}
	if (body != NULL) {
		dom_node_unref(body);
	}
	return JS_UNDEFINED;
%}

getter Element::attributes()
%{
	dom_namednodemap *nmap = NULL;
	JSValue map, proxy;

	proxy = qjsky_hidden_get(ctx, this_val, QJSKY_HIDDEN_ATTRIBUTES, false);
	if (!JS_IsUndefined(proxy)) return proxy;

	if (dom_node_get_attributes(priv->parent.node, &nmap) != DOM_NO_ERR) return JS_UNDEFINED;
	map = qjsky_named_node_map___create(ctx, nmap);
	dom_namednodemap_unref(nmap);
	proxy = qjsky_list_proxy(ctx, "makeNodeMapProxy", map);
	if (JS_IsException(proxy)) return proxy;
	qjsky_hidden_set(ctx, this_val, QJSKY_HIDDEN_ATTRIBUTES, JS_DupValue(ctx, proxy));
	return proxy;
%}

method Element::hasAttributes()
%{
	bool result = false;

	if (dom_node_has_attributes(priv->parent.node, &result) != DOM_NO_ERR) return JS_FALSE;
	return JS_NewBool(ctx, result);
%}

method Element::getAttributeNS()
%{
	dom_string *ns, *local, *value = NULL;
	dom_exception exc;
	JSValue ret;

	if (!element_ns_args(ctx, argv, &ns, &local)) return JS_EXCEPTION;
	exc = dom_element_get_attribute_ns(priv->parent.node, ns, local, &value);
	element_ns_free(ns, local);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	if (value == NULL) return JS_NULL;
	ret = qjsky_string(ctx, value);
	dom_string_unref(value);
	return ret;
%}

method Element::setAttributeNS()
%{
	dom_string *ns, *qname, *value;
	dom_exception exc;

	if (!element_ns_args(ctx, argv, &ns, &qname)) return JS_EXCEPTION;
	value = qjsky_to_dom_string(ctx, argv[2]);
	if (value == NULL) {
		element_ns_free(ns, qname);
		return JS_EXCEPTION;
	}
	exc = dom_element_set_attribute_ns(priv->parent.node, ns, qname, value);
	element_ns_free(ns, qname);
	dom_string_unref(value);
	return exc == DOM_NO_ERR ? JS_UNDEFINED : qjsky_throw_dom(ctx, exc);
%}

method Element::removeAttributeNS()
%{
	dom_string *ns, *local;
	dom_exception exc;

	if (!element_ns_args(ctx, argv, &ns, &local)) return JS_EXCEPTION;
	exc = dom_element_remove_attribute_ns(priv->parent.node, ns, local);
	element_ns_free(ns, local);
	return exc == DOM_NO_ERR ? JS_UNDEFINED : qjsky_throw_dom(ctx, exc);
%}

method Element::hasAttributeNS()
%{
	dom_string *ns, *local;
	bool result = false;
	dom_exception exc;

	if (!element_ns_args(ctx, argv, &ns, &local)) return JS_EXCEPTION;
	exc = dom_element_has_attribute_ns(priv->parent.node, ns, local, &result);
	element_ns_free(ns, local);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	return JS_NewBool(ctx, result);
%}

method Element::getAttributeNode()
%{
	dom_string *name = qjsky_to_dom_string(ctx, argv[0]);
	dom_attr *attr = NULL;
	dom_exception exc;

	if (name == NULL) return JS_EXCEPTION;
	exc = dom_element_get_attribute_node(priv->parent.node, name, &attr);
	dom_string_unref(name);
	return element_node_result(ctx, exc, (dom_node *)attr);
%}

method Element::getAttributeNodeNS()
%{
	dom_string *ns, *local;
	dom_attr *attr = NULL;
	dom_exception exc;

	if (!element_ns_args(ctx, argv, &ns, &local)) return JS_EXCEPTION;
	exc = dom_element_get_attribute_node_ns(priv->parent.node, ns, local, &attr);
	element_ns_free(ns, local);
	return element_node_result(ctx, exc, (dom_node *)attr);
%}

method Element::setAttributeNode()
%{
	dom_node *attr = element_attr_arg(ctx, argv[0]);
	dom_attr *old = NULL;

	if (attr == NULL) return JS_EXCEPTION;
	return element_node_result(ctx, dom_element_set_attribute_node(priv->parent.node, attr, &old), (dom_node *)old);
%}

method Element::setAttributeNodeNS()
%{
	dom_node *attr = element_attr_arg(ctx, argv[0]);
	dom_attr *old = NULL;

	if (attr == NULL) return JS_EXCEPTION;
	return element_node_result(ctx, dom_element_set_attribute_node_ns(priv->parent.node, attr, &old), (dom_node *)old);
%}

method Element::removeAttributeNode()
%{
	dom_node *attr = element_attr_arg(ctx, argv[0]);
	dom_attr *removed = NULL;

	if (attr == NULL) return JS_EXCEPTION;
	return element_node_result(ctx, dom_element_remove_attribute_node(priv->parent.node, attr, &removed), (dom_node *)removed);
%}

method Element::getElementsByTagNameNS()
%{
	dom_nodelist *nodes = NULL;
	dom_string *ns, *local;
	dom_exception exc;
	JSValue list;

	if (!element_ns_args(ctx, argv, &ns, &local)) return JS_EXCEPTION;
	exc = dom_element_get_elements_by_tag_name_ns(priv->parent.node, ns, local, &nodes);
	element_ns_free(ns, local);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	list = qjsky_node_list___create(ctx, nodes);
	dom_nodelist_unref(nodes);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}

method Element::getElementsByClassName()
%{
	dom_nodelist *nodes = NULL;
	dom_exception err;
	dom_string *names;
	JSValue list;

	names = qjsky_to_dom_string(ctx, argv[0]);
	if (names == NULL) return JS_EXCEPTION;
	err = dom_node_get_elements_by_class_name((struct dom_node *)((node_private_t *)priv)->node, names, &nodes);
	dom_string_unref(names);
	if (err != DOM_NO_ERR || nodes == NULL) return JS_UNDEFINED;
	list = qjsky_node_list___create(ctx, nodes);
	dom_nodelist_unref(nodes);
	return qjsky_list_proxy(ctx, "makeListProxy", list);
%}

class NamedNodeMap {
	private struct dom_namednodemap *map;
};

init NamedNodeMap(struct dom_namednodemap *map)
%{
	priv->map = map;
	dom_namednodemap_ref(map);
%}

fini NamedNodeMap()
%{
	dom_namednodemap_unref(priv->map);
%}

getter NamedNodeMap::length()
%{
	uint32_t len;

	if (dom_namednodemap_get_length(priv->map, &len) != DOM_NO_ERR) return JS_UNDEFINED;
	return JS_NewUint32(ctx, len);
%}

method NamedNodeMap::item()
%{
	uint32_t i;
	dom_node *node = NULL;
	JSValue ret;

	if (JS_ToUint32(ctx, &i, argv[0]) < 0) return JS_EXCEPTION;
	if (dom_namednodemap_item(priv->map, i, &node) != DOM_NO_ERR) return JS_UNDEFINED;
	ret = qjsky_node(ctx, node);
	if (node != NULL) dom_node_unref(node);
	return ret;
%}

method NamedNodeMap::getNamedItem()
%{
	dom_exception exc;
	dom_node *attr = NULL;
	dom_string *name = qjsky_to_dom_string(ctx, argv[0]);
	JSValue ret;

	if (name == NULL) return JS_EXCEPTION;
	exc = dom_namednodemap_get_named_item(priv->map, name, &attr);
	dom_string_unref(name);
	if (exc != DOM_NO_ERR) return JS_UNDEFINED;
	ret = qjsky_node(ctx, attr);
	if (attr != NULL) dom_node_unref(attr);
	return ret;
%}

method NamedNodeMap::getNamedItemNS()
%{
	dom_string *ns, *local;
	dom_node *attr = NULL;
	dom_exception exc;
	JSValue ret;

	if (!qjsky_to_dom_namespace(ctx, argv[0], &ns)) return JS_EXCEPTION;
	local = qjsky_to_dom_string(ctx, argv[1]);
	if (local == NULL) {
		if (ns != NULL) dom_string_unref(ns);
		return JS_EXCEPTION;
	}
	exc = dom_namednodemap_get_named_item_ns(priv->map, ns, local, &attr);
	if (ns != NULL) dom_string_unref(ns);
	dom_string_unref(local);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, attr);
	if (attr != NULL) dom_node_unref(attr);
	return ret;
%}

method NamedNodeMap::setNamedItem()
%{
	node_private_t *np = qjsky_private(ctx, argv[0], QJSKY_IFACE_NODE);
	dom_node *old = NULL;
	dom_exception exc;
	JSValue ret;

	if (np == NULL) return JS_ThrowTypeError(ctx, "parameter 1 is not of type 'Attr'");
	exc = dom_namednodemap_set_named_item(priv->map, np->node, &old);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, old);
	if (old != NULL) dom_node_unref(old);
	return ret;
%}

method NamedNodeMap::setNamedItemNS()
%{
	node_private_t *np = qjsky_private(ctx, argv[0], QJSKY_IFACE_NODE);
	dom_node *old = NULL;
	dom_exception exc;
	JSValue ret;

	if (np == NULL) return JS_ThrowTypeError(ctx, "parameter 1 is not of type 'Attr'");
	exc = dom_namednodemap_set_named_item_ns(priv->map, np->node, &old);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, old);
	if (old != NULL) dom_node_unref(old);
	return ret;
%}

method NamedNodeMap::removeNamedItem()
%{
	dom_string *name = qjsky_to_dom_string(ctx, argv[0]);
	dom_node *removed = NULL;
	dom_exception exc;
	JSValue ret;

	if (name == NULL) return JS_EXCEPTION;
	exc = dom_namednodemap_remove_named_item(priv->map, name, &removed);
	dom_string_unref(name);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, removed);
	if (removed != NULL) dom_node_unref(removed);
	return ret;
%}

method NamedNodeMap::removeNamedItemNS()
%{
	dom_string *ns, *local;
	dom_node *removed = NULL;
	dom_exception exc;
	JSValue ret;

	if (!qjsky_to_dom_namespace(ctx, argv[0], &ns)) return JS_EXCEPTION;
	local = qjsky_to_dom_string(ctx, argv[1]);
	if (local == NULL) {
		if (ns != NULL) dom_string_unref(ns);
		return JS_EXCEPTION;
	}
	exc = dom_namednodemap_remove_named_item_ns(priv->map, ns, local, &removed);
	if (ns != NULL) dom_string_unref(ns);
	dom_string_unref(local);
	if (exc != DOM_NO_ERR) return qjsky_throw_dom(ctx, exc);
	ret = qjsky_node(ctx, removed);
	if (removed != NULL) dom_node_unref(removed);
	return ret;
%}

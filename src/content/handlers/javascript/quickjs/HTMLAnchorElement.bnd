getter HTMLAnchorElement::href()
%{
	return qjsky_element_url_get(ctx, priv->parent.parent.parent.node, QJSKY_URL_HREF);
%}

setter HTMLAnchorElement::href()
%{
	return qjsky_element_url_set(ctx, priv->parent.parent.parent.node, QJSKY_URL_HREF, argv[0]);
%}


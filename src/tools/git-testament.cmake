cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ROOT OR NOT DEFINED TARGET)
  message(FATAL_ERROR "usage: cmake -DROOT=<dir> -DTARGET=<file> -P git-testament.cmake")
endif()

set(ENV{LC_ALL} C)

function(c_escape out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(git_output out)
  execute_process(COMMAND git ${ARGN}
    WORKING_DIRECTORY ${ROOT}
    OUTPUT_VARIABLE output
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(${out} "${output}" PARENT_SCOPE)
endfunction()

set(url "http://nowhere/tarball/")
set(revision "unknown")
set(branch "tarball")
set(tag "")
set(modifications "")

find_program(GIT_EXECUTABLE git)
if(EXISTS "${ROOT}/.git" AND GIT_EXECUTABLE)
  git_output(remotes config --get-regexp "^remote.*.url$")
  string(REGEX MATCH "^[^ \n]+ ([^\n]+)" match "${remotes}")
  set(url "${CMAKE_MATCH_1}")
  git_output(revision rev-parse HEAD)
  git_output(symref symbolic-ref HEAD)
  if(symref STREQUAL "")
    git_output(symref show-ref -s HEAD)
  endif()
  git_output(branch for-each-ref "--format=%(refname:short)" ${symref})
  git_output(tag describe --tags --exact-match HEAD)
  string(REGEX REPLACE "[ \t\n].*" "" tag "${tag}")
  if(NOT tag STREQUAL "")
    set(branch "${tag}")
  endif()

  git_output(status status --porcelain)
  string(REPLACE "\n" ";" status_lines "${status}")
  foreach(line IN LISTS status_lines)
    if(NOT line MATCHES "^(..) (.+)$")
      continue()
    endif()
    set(state "${CMAKE_MATCH_1}")
    set(file "${CMAKE_MATCH_2}")
    if(file MATCHES "^(.+) -> ")
      set(file "${CMAKE_MATCH_1}")
    endif()
    if(file MATCHES "\\.(d|a|md5|map|gitt)$")
      continue()
    endif()
    c_escape(file "${file}")
    list(APPEND modifications "  { \"${file}\", \"${state}\" }")
  endforeach()
  list(SORT modifications)
endif()

set(username "$ENV{USER}")
if(username STREQUAL "")
  set(username "$ENV{LOGNAME}")
endif()
if(username STREQUAL "")
  set(username "unknown")
endif()
set(gecos "${username}")
execute_process(COMMAND getent passwd "${username}"
  OUTPUT_VARIABLE pwent
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REPLACE ":" ";" pwent "${pwent}")
list(LENGTH pwent pwlen)
if(pwlen GREATER 4)
  list(GET pwent 4 gecos_field)
  string(REGEX REPLACE ",.*" "" gecos_field "${gecos_field}")
  if(NOT gecos_field STREQUAL "")
    set(gecos "${gecos_field}")
  endif()
endif()
string(REPLACE "\"" "'" gecos "${gecos}")
c_escape(gecos "${gecos}")
c_escape(username "${username}")

cmake_host_system_information(RESULT hostname QUERY HOSTNAME)
if(hostname STREQUAL "")
  set(hostname "unknown-host")
endif()
c_escape(hostname "${hostname}")

get_filename_component(root "${ROOT}" NAME)
if(NOT root MATCHES "/$")
  string(APPEND root "/")
endif()
c_escape(root "${root}")

string(TIMESTAMP compiledate "%d.%m.%Y")

set(testament "")
string(APPEND testament "#define USERNAME \"${username}\"\n")
string(APPEND testament "#define GECOS \"${gecos}\"\n")
string(APPEND testament "#define WT_ROOT \"${root}\"\n")
string(APPEND testament "#define WT_HOSTNAME \"${hostname}\"\n")
string(APPEND testament "#define WT_COMPILEDATE \"${compiledate}\"\n")
if(NOT "$ENV{CI_BUILD}" STREQUAL "")
  c_escape(ci_build "$ENV{CI_BUILD}")
  string(APPEND testament "#define CI_BUILD \"${ci_build}\"\n")
endif()
c_escape(branch "${branch}")
string(APPEND testament "#define WT_BRANCHPATH \"${branch}\"\n")
if(branch STREQUAL "master")
  string(APPEND testament "#define WT_BRANCHISMASTER 1\n")
endif()
if(NOT tag STREQUAL "")
  c_escape(tag "${tag}")
  string(APPEND testament "#define WT_BRANCHISTAG 1\n")
  string(APPEND testament "#define WT_TAGIS \"${tag}\"\n")
endif()
if(url MATCHES "/tarball/")
  string(APPEND testament "#define WT_NO_GIT 1\n")
endif()
string(APPEND testament "#define WT_REVID \"${revision}\"\n")
list(LENGTH modifications modified)
string(APPEND testament "#define WT_MODIFIED ${modified}\n")
list(JOIN modifications ", \\\n" joined)
string(APPEND testament "#define WT_MODIFICATIONS {\\\n${joined} \\\n}\n")

string(APPEND testament "#define WT_SBOM {\\\n")
get_filename_component(target_dir "${TARGET}" DIRECTORY)
if(EXISTS "${target_dir}/sbom")
  file(STRINGS "${target_dir}/sbom" sbom_lines)
  foreach(line IN LISTS sbom_lines)
    c_escape(line "${line}")
    string(APPEND testament "\"${line}\", \\\n")
  endforeach()
endif()
string(APPEND testament "NULL, \\\n}\n")

string(MD5 checksum "${testament}")
if(EXISTS "${TARGET}")
  file(STRINGS "${TARGET}" old_checksum REGEX "MD5:[0-9a-f]+")
  if(old_checksum MATCHES "MD5:${checksum}")
    return()
  endif()
endif()

file(WRITE "${TARGET}" "/* ${TARGET}
 *
 * Revision testament.
 *
 * *WARNING* this file is automatically generated by git-testament.cmake
 *
 * Copyright 2012 NetSurfy Browser Project
 */

#ifndef NETSURFY_REVISION_TESTAMENT
#define NETSURFY_REVISION_TESTAMENT \"${checksum}\"

/* Revision testament checksum:
 * MD5:${checksum}
 */

/* Revision testament: */
${testament}
#endif
")
